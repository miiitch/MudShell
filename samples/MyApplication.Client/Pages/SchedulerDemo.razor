@page "/scheduler"
@layout DemoLayout
@using MudShell.Components.Scheduler
@inject IDialogService Dialogs

<PageTitle>Scheduler</PageTitle>

<MdsPageHeader Title="Scheduler">
    <StartContent><div></div></StartContent>
</MdsPageHeader>

<MudStack Spacing="4" Class="pa-4">
    <MudText Typo="Typo.body2" Color="Color.Secondary">
        MdsScheduler wraps the free Radzen scheduler. Its toolbar and grid follow the active MudBlazor theme, and
        its own labels stay in English while the appointment titles below remain as typed.
    </MudText>

    <MudStack Row="true" Spacing="3" Wrap="Wrap.Wrap">
        <MudSwitch T="bool" @bind-Value="_useTemplate" Label="Custom appointment template" Color="Color.Primary" />
        <MudSwitch T="bool" @bind-Value="_loading" Label="Loading" Color="Color.Primary" />
        <MudSwitch T="bool" @bind-Value="_disabled" Label="Disabled" Color="Color.Primary" />
    </MudStack>

    <MdsScheduler TItem="SchedulerBooking"
                  data-testid="demo-scheduler"
                  Items="_bookings"
                  StartProperty="@nameof(SchedulerBooking.Start)"
                  EndProperty="@nameof(SchedulerBooking.End)"
                  TextProperty="@nameof(SchedulerBooking.Title)"
                  @bind-SelectedDate="_selectedDate"
                  View="_view"
                  ViewChanged="OnViewChanged"
                  AppointmentClicked="OnAppointmentClicked"
                  SlotClicked="OnSlotClicked"
                  AppointmentTemplate="@(_useTemplate ? BookingTemplate : null)"
                  Loading="_loading"
                  Disabled="_disabled" />
</MudStack>

@code {
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    private readonly RenderFragment<SchedulerBooking> BookingTemplate = booking =>
        @<MudText Typo="Typo.body2" Style="font-weight: 600;">@booking.Title</MudText>;

    private List<SchedulerBooking> _bookings = [];
    private DateTime? _selectedDate = DateTime.Today;
    private MdsSchedulerView _view = MdsSchedulerView.Week;
    private bool _useTemplate = true;
    private bool _loading;
    private bool _disabled;

    protected override void OnInitialized()
    {
        var monday = DateTime.Today.AddDays(-(((int)DateTime.Today.DayOfWeek + 6) % 7));

        _bookings =
        [
            new() { Title = "Réunion client", Start = monday.AddHours(9), End = monday.AddHours(10) },
            new() { Title = "Congés Michel", Start = monday.AddDays(1), End = monday.AddDays(3) },
            new() { Title = "Présentation architecture", Start = monday.AddDays(2).AddHours(14), End = monday.AddDays(2).AddHours(15).AddMinutes(30) },
            new() { Title = "Revue de code", Start = monday.AddDays(4).AddHours(11), End = monday.AddDays(4).AddHours(12) },
        ];
    }

    private void OnViewChanged(MdsSchedulerView view) => _view = view;

    private Task OnSlotClicked(MdsSchedulerSlotEventArgs args) =>
        OpenDialogAsync(new SchedulerBooking { Title = string.Empty, Start = args.Start, End = args.End }, isNew: true);

    private Task OnAppointmentClicked(MdsSchedulerAppointmentEventArgs<SchedulerBooking> args) =>
        OpenDialogAsync(args.Item, isNew: false);

    private async Task OpenDialogAsync(SchedulerBooking booking, bool isNew)
    {
        var parameters = new DialogParameters<SchedulerBookingDialog>
        {
            { d => d.Title, booking.Title },
            { d => d.Start, booking.Start },
            { d => d.End, booking.End },
        };

        var dialog = await Dialogs.ShowAsync<SchedulerBookingDialog>(isNew ? "New appointment" : "Edit appointment", parameters, _dialogOptions);
        var result = await dialog.Result;

        if (result is null || result.Canceled || result.Data is not SchedulerBooking edited)
        {
            return;
        }

        // A new list keeps the scheduler's Items parameter changing, so it reloads the appointments.
        var updated = _bookings.Where(b => b.Id != booking.Id).ToList();
        updated.Add(new SchedulerBooking { Id = isNew ? Guid.NewGuid() : booking.Id, Title = edited.Title, Start = edited.Start, End = edited.End });
        _bookings = updated;
    }
}
