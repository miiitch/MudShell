@page "/main-components/bg"
@rendermode InteractiveServer

<PageTitle>Composants principaux BG</PageTitle>

<MdsPageHeader Title="Composants principaux (BG)">
    <StartContent><div></div></StartContent>
    <EndContent>
        <MdsMainButton Variant="Variant.Outlined" Color="Color.Inherit" Href="/main-components" Compact="true">
            Revenir palette
        </MdsMainButton>
    </EndContent>
</MdsPageHeader>

<MudStack Spacing="4" Class="my-2">
    <MdsMainToolbar>
        <MdsMainStatusBadge Label="Background image" Status="info" />
        <MdsMainStatusBadge Label="Theme compatible" Status="success" />
        <MudSpacer />
        <MdsMainButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.ColorLens">
            Changer thème
        </MdsMainButton>
    </MdsMainToolbar>

    <MdsMainSection Title="Rendu en mode BG"
                    Description="Les wrappers restent lisibles au-dessus du fond image."
                    Icon="@Icons.Material.Outlined.Wallpaper">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MdsMainPart Title="Bloc 1" Subtitle="Surface harmonisée">
                    <MudText Typo="Typo.body2">Utilisez les wrappers au lieu des composants Mud bruts pour garder une cohérence visuelle.</MudText>
                </MdsMainPart>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MdsMainPart Title="Bloc 2" Subtitle="Actions standardisées">
                    <MudStack Row="true" Spacing="1">
                        <MdsMainButton Compact="true">Action primaire</MdsMainButton>
                        <MdsMainButton Compact="true" Variant="Variant.Outlined" Color="Color.Default">Secondaire</MdsMainButton>
                    </MudStack>
                </MdsMainPart>
            </MudItem>
        </MudGrid>
    </MdsMainSection>
</MudStack>
