<MudPaper Outlined="true" Class="pa-3" data-testid="chat-part-chart">
    <MudText Typo="Typo.subtitle2">@Payload.Title</MudText>
    @foreach (var (label, value) in Payload.Values)
    {
        <div class="d-flex align-center gap-2">
            <MudText Typo="Typo.caption" Style="width: 64px">@label</MudText>
            <MudProgressLinear Value="@value" Max="100" Color="Color.Primary" Class="flex-grow-1" />
        </div>
    }
</MudPaper>

@code {
    public sealed record ChartData(string Title, IReadOnlyList<(string Label, double Value)> Values);

    [Parameter, EditorRequired] public ChartData Payload { get; set; } = default!;
}
