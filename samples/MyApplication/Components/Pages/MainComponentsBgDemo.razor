@page "/main-components/bg"
@rendermode InteractiveServer

<PageTitle>Main components BG</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="px-4 pb-4 pt-0">
<MdsPageHeader Title="Main components (BG)">
    <StartContent><div></div></StartContent>
    <EndContent>
        <MdsMainButton Variant="Variant.Outlined" Color="Color.Inherit" Href="/main-components" Compact="true">
            Back to palette
        </MdsMainButton>
    </EndContent>
</MdsPageHeader>

<MudStack Spacing="4" Class="my-2">
    <MdsMainToolbar>
        <MdsMainStatusBadge Label="Background image" Status="info" />
        <MdsMainStatusBadge Label="Theme compatible" Status="success" />
        <MudSpacer />
        <MdsMainButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.ColorLens">
            Change theme
        </MdsMainButton>
    </MdsMainToolbar>

    <MdsMainSection Title="Rendering in BG mode"
                    Description="Wrappers stay readable above the background image."
                    Icon="@Icons.Material.Outlined.Wallpaper">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MdsMainPart Title="Block 1" Subtitle="Harmonized surface">
                    <MudText Typo="Typo.body2">Use wrappers instead of raw Mud components to keep visual consistency.</MudText>
                </MdsMainPart>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MdsMainPart Title="Block 2" Subtitle="Standardized actions">
                    <MudStack Row="true" Spacing="1">
                        <MdsMainButton Compact="true">Primary action</MdsMainButton>
                        <MdsMainButton Compact="true" Variant="Variant.Outlined" Color="Color.Default">Secondary</MdsMainButton>
                    </MudStack>
                </MdsMainPart>
            </MudItem>
        </MudGrid>
    </MdsMainSection>
</MudStack>
</MudContainer>
