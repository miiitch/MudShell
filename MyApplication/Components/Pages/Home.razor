@page "/"
@rendermode InteractiveServer
@inject NavigationManager Nav

<PageTitle>Home</PageTitle>

<div class="home-topbar">
    <MudIconButton Icon="@Icons.Material.Outlined.Tune" Color="Color.Inherit" Size="Size.Small" />
</div>

<div class="home-content">
    <MudText Typo="Typo.h4" Class="home-greeting">
        C'est un plaisir te revoir, Michel.<br />
        Quelles sont les dernières nouvelles?
    </MudText>

    <MbxChatBar Placeholder="@("Message Copilot ou @ mentionnez un onglet")"
                @bind-Value="_chatMessage">
        <Actions>
            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Inherit" />
            <MudButton Variant="Variant.Text" Color="Color.Inherit" Size="Size.Small"
                       EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                       Style="font-size:13px; text-transform:none; font-weight:500;">Smart</MudButton>
            <div style="flex:1"></div>
            <MudIconButton Icon="@Icons.Material.Filled.GraphicEq" Size="Size.Small" Color="Color.Inherit" />
        </Actions>
    </MbxChatBar>

    <div class="render-modes-links">
        <MudText Typo="Typo.subtitle1" Class="render-modes-title">
            <MudIcon Icon="@Icons.Material.Outlined.Devices" Size="Size.Small" Style="margin-right:8px; vertical-align:middle;" />
            Modes de rendu Blazor
        </MudText>

        <div class="render-modes-grid">
            <MudButton Variant="Variant.Outlined" Color="Color.Default"
                       OnClick="@(() => Nav.NavigateTo("/modes/ssr", true))"
                       StartIcon="@Icons.Material.Outlined.Article" Class="render-mode-btn">
                Static SSR
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Info" Href="/modes/server"
                       StartIcon="@Icons.Material.Outlined.Hub" Class="render-mode-btn">
                Interactive Server
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Success" Href="/modes/wasm"
                       StartIcon="@Icons.Material.Outlined.Memory" Class="render-mode-btn">
                Auto (WASM)
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Href="/modes/auto"
                       StartIcon="@Icons.Material.Outlined.AutoMode" Class="render-mode-btn">
                Interactive Auto
            </MudButton>
        </div>

        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/modes"
                   EndIcon="@Icons.Material.Filled.ArrowForward"
                   Style="margin-top:4px; text-transform:none; font-weight:500;">
            Voir toutes les combinaisons
        </MudButton>
    </div>
</div>

@code {
    private string _chatMessage = string.Empty;
}
