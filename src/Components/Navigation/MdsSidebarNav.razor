@namespace MudShell.Components.Navigation
@using Microsoft.AspNetCore.Components.Routing
@using MudShell.Components.Navigation.Models
@using MudShell.Components.Navigation.State
@inject NavigationManager Nav

@if (IsExpanded)
{
    <MudNavMenu Color="Color.Primary" Rounded="true" Dense="true" Class="@($"mbx-sidebar-nav {Class}")">
        @foreach (var node in Items)
        {
            @if (node.Children.Count > 0)
            {
                var expanded = _expandedIds.Contains(node.Id) || State.ActivePath.Contains(node.Id);
                <MudNavGroup Title="@node.Text"
                             Icon="@(node.Icon ?? Icons.Material.Outlined.Circle)"
                             IconColor="Color.Inherit"
                             Expanded="@expanded"
                             ExpandedChanged="@(v => ToggleGroup(node.Id, v))"
                             HideExpandIcon="@node.Disabled"
                             Class="mbx-nav-group">
                    @foreach (var child in node.Children.Where(c => c.Visible))
                    {
                        <MudNavLink Href="@child.Href"
                                    Icon="@child.Icon"
                                    IconColor="Color.Inherit"
                                    Disabled="@child.Disabled"
                                    ActiveClass="mbx-nav-link-active">
                            @child.Text
                        </MudNavLink>
                    }
                </MudNavGroup>
            }
            else
            {
                <MudNavLink Href="@node.Href"
                            Icon="@(node.Icon ?? Icons.Material.Outlined.Circle)"
                            IconColor="Color.Inherit"
                            Disabled="@node.Disabled"
                            ActiveClass="mbx-nav-link-active">
                    @node.Text
                </MudNavLink>
            }
        }
    </MudNavMenu>
}
else
{
    <div class="mbx-sidebar-nav-collapsed @Class">
        @foreach (var node in Items)
        {
            var isActive = State.ActivePath.Contains(node.Id);
            var iconLinkClass = $"mbx-sidebar-nav-icon-link{(isActive ? " mbx-sidebar-nav-icon-link-active" : "")}";
            <MudTooltip Text="@node.Text" Placement="Placement.Right">
                @if (!string.IsNullOrWhiteSpace(node.Href) && !node.Disabled)
                {
                    <NavLink href="@node.Href"
                             Match="@ToNavLinkMatch(node.Match)"
                             class="@iconLinkClass"
                             title="@node.Text">
                        <MudIcon Icon="@(node.Icon ?? Icons.Material.Outlined.Circle)" Size="Size.Small" />
                    </NavLink>
                }
                else
                {
                    <MudIconButton Icon="@(node.Icon ?? Icons.Material.Outlined.Circle)"
                                   Disabled="@node.Disabled"
                                   Color="Color.Inherit"
                                   Size="Size.Small" />
                }
            </MudTooltip>
        }
    </div>
}

@code {
    [Parameter] public MbxNavTree? Tree       { get; set; }
    [Parameter] public bool IsExpanded        { get; set; } = true;
    [Parameter] public string? CurrentUri     { get; set; }
    [Parameter] public string? Class          { get; set; }

    private IReadOnlyList<MbxNavNode> Items =>
        Tree?.Roots.Where(n => n.Visible).ToList() ?? [];

    private MbxNavState State =>
        MbxNavStateResolver.Resolve(Tree, CurrentUri ?? Nav.Uri);

    private readonly HashSet<string> _expandedIds = new(StringComparer.Ordinal);

    private void ToggleGroup(string id, bool isExpanded)
    {
        if (isExpanded) _expandedIds.Add(id);
        else _expandedIds.Remove(id);
    }

    private static NavLinkMatch ToNavLinkMatch(MbxNavMatchMode matchMode) =>
        matchMode == MbxNavMatchMode.All ? NavLinkMatch.All : NavLinkMatch.Prefix;
}
