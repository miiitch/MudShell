@page "/examples"
@rendermode InteractiveServer

<PageTitle>Examples — MudShell</PageTitle>
<div class="showcase-page" data-testid="showcase-examples">
    <MdsPageHeader Title="Complete interfaces." BreadcrumbItems="@_breadcrumbs" />
    <p>Sample data, real use cases. Each screen combines MudShell and MudBlazor components.</p>
    <div class="showcase-cards">
        @foreach (var example in _examples)
        {
            <a class="showcase-card" href="@example.Href">
                <MudIcon Icon="@example.Icon" Color="Color.Primary" />
                <h2>@example.Title</h2><p>@example.Description</p><span>Explore this example →</span>
            </a>
        }
    </div>
</div>

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs = [new("Home", "/")];
    private readonly (string Title, string Description, string Href, string Icon)[] _examples =
    [
        ("List / detail workspace", "A grid, preview, tabs, independently scrolling regions and metrics.", "/examples/workspace", Icons.Material.Outlined.ViewQuilt),
        ("Document library", "Cards, categories and document search.", "/examples/library", Icons.Material.Outlined.Folder),
        ("Weather dashboard", "Metrics, filters and tabular forecasts.", "/examples/weather", Icons.Material.Outlined.Cloud),
        ("European cities", "Explore and compare tabular data.", "/examples/cities", Icons.Material.Outlined.TableChart),
        ("Conversation and assistant", "Compose a message, stream a response and display rich content.", "/components/conversation", Icons.Material.Outlined.Chat),
        ("Floating assistant", "A conversation accessible above the page content.", "/components/conversation/floating", Icons.Material.Outlined.QuestionAnswer)
    ];
}
