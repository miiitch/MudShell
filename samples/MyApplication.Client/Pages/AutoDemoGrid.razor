@page "/modes/auto/grid"
@rendermode InteractiveAuto
@layout DemoLayout
@using MyApplication.Client.Layouts

<PageTitle>Interactive Auto — Grid</PageTitle>

<div class="fullpage-demo">
    <MbxPageHeader Title="Interactive Auto — Grid">
        <StartContent><div></div></StartContent>
        <EndContent>
            <MudChip T="string" Color="Color.Warning" Size="Size.Small">Server → WASM</MudChip>
            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Style="margin-left:8px;">Grid</MudChip>
        </EndContent>
    </MbxPageHeader>

    <div class="fullpage-body">
        <GridShowcase RenderModeName="Interactive Auto"
                      BadgeColor="auto"
                      BadgeIcon="@Icons.Material.Outlined.AutoMode" />
    </div>
</div>

