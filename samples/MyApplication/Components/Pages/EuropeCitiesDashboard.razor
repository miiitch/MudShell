            new CitySeed("Cork", "Irlande", "Nord", "GMT", 224000, 14900),
            new CitySeed("Londres", "Royaume-Uni", "Nord", "GMT", 8982000, 684500),
            new CitySeed("Manchester", "Royaume-Uni", "Nord", "GMT", 568000, 62800),
            new CitySeed("Edimbourg", "Royaume-Uni", "Nord", "GMT", 506000, 33800),
            new CitySeed("Birmingham", "Royaume-Uni", "Nord", "GMT", 1141000, 74200),
            new CitySeed("Stockholm", "Suede", "Nord", "CET", 985000, 79200),
            new CitySeed("Goteborg", "Suede", "Nord", "CET", 587000, 36200),
            new CitySeed("Malmo", "Suede", "Nord", "CET", 362000, 17300),
            new CitySeed("Copenhague", "Danemark", "Nord", "CET", 659000, 73400),
            new CitySeed("Aarhus", "Danemark", "Nord", "CET", 288000, 16400),
            new CitySeed("Helsinki", "Finlande", "Nord", "EET", 664000, 52100),
            new CitySeed("Espoo", "Finlande", "Nord", "EET", 312000, 18200),
            new CitySeed("Oslo", "Norvege", "Nord", "CET", 714000, 96300),
            new CitySeed("Bergen", "Norvege", "Nord", "CET", 286000, 22100),
            new CitySeed("Zurich", "Suisse", "Centre", "CET", 443000, 128700),
            new CitySeed("Geneve", "Suisse", "Centre", "CET", 203000, 65700),
            new CitySeed("Lausanne", "Suisse", "Centre", "CET", 144000, 27900)
        };

        var rows = new CityRow[1000];
        for (var i = 0; i < rows.Length; i++)
        {
            var seed = catalog[i % catalog.Length];
            var sector = (i % 20) + 1;
            var cycle = i / catalog.Length;
            rows[i] = new CityRow(
                $"{seed.City} - Zone {sector:00}",
                seed.Country,
                seed.Region,
                seed.Population + cycle * 250,
                seed.LocalGdpMEur + cycle * 45,
                seed.TimeZone);
        }

        return rows;
    }

    private sealed record CitySeed(string City, string Country, string Region, string TimeZone, int Population, int LocalGdpMEur);
    private sealed record WidgetItem(string Label, string Value, string Trend);
    private sealed record CityRow(string City, string Country, string Region, int Population, int LocalGdpMEur, string TimeZone);
}




