@inject IDialogService DialogService
@inject ThemeState ThemeState

@* On mobile the level-1 bar is rendered by MainLayout (MdsBottomNav), so the rail is not rendered here. *@
@if (ShellMode != MdsAppShell.MbxShellMode.Mobile)
{
    <MdsSidebar IsExpanded="@(IsExpanded && ShellMode == MdsAppShell.MbxShellMode.Desktop)"
                OnToggle="@HandleToggle"
                PrimaryItems="@_primaryItems">

        <LogoContent>
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Medium"
                     Style="background: linear-gradient(135deg, #ff6b6b, #ffd93d, #6bcf7f, #4ecdc4, #7e6fff); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-size: 28px; flex-shrink:0;" />
            @if (IsExpanded)
            {
                <span class="nav-app-title">Copilot</span>
            }
        </LogoContent>

        <BottomContent>
            <MudAvatar Size="Size.Small" Style="cursor: pointer; background: var(--mud-palette-gray-light); flex-shrink: 0;">
                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
            </MudAvatar>
            @if (IsExpanded)
            {
                <div class="nav-profile-info">
                    <span class="nav-profile-name">Michel</span>
                    <span class="nav-profile-sub">Microsoft 365</span>
                </div>
                <MudIconButton Icon="@(ThemeState.IsDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                               Size="Size.Small" Color="Color.Inherit"
                               title="@(ThemeState.IsDarkMode ? "Light mode" : "Dark mode")"
                               OnClick="@(() => ThemeState.SetDarkMode(!ThemeState.IsDarkMode))"
                               Style="flex-shrink:0;" />
                <MudIconButton Icon="@Icons.Material.Outlined.ColorLens"
                               Size="Size.Small" Color="Color.Inherit"
                               title="Theme and background"
                               OnClick="@OpenThemeDialog"
                               Style="flex-shrink:0; margin-left:0;" />
            }
        </BottomContent>

    </MdsSidebar>
}

@code {
    [Parameter] public MdsAppShell? ShellRef    { get; set; }
    [Parameter] public bool          IsExpanded  { get; set; }
    [Parameter] public MdsAppShell.MbxShellMode ShellMode { get; set; } = MdsAppShell.MbxShellMode.Desktop;

    // Desktop: the rail toggle expands the sidebar. Tablet: it opens the level-2 overlay instead,
    // because the rail has no expanded mode there.
    private void HandleToggle()
    {
        if (ShellMode == MdsAppShell.MbxShellMode.Desktop) ShellRef?.ToggleSidebar();
        else ShellRef?.ToggleContextPanel();
    }

    private readonly MbxNavItem[] _primaryItems =
    [
        new(Icons.Material.Outlined.GridView,      "Home",          "/"),
        new(Icons.Material.Outlined.Cloud,         "Weather",       "/meteo"),
        new(Icons.Material.Outlined.TableChart,    "Europe Cities", "/europe-cities"),
        new(Icons.Material.Outlined.ContentCopy,   "Library",       "/library"),
        new(Icons.Material.Outlined.Palette,       "Demo",          "/demo"),
        new(Icons.Material.Outlined.Widgets,       "Components",    "/components"),
        new(Icons.Material.Outlined.ViewQuilt,     "Fill layout",   "/fill-demo"),
    ];


    private async Task OpenThemeDialog()
    {
        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        await DialogService.ShowAsync<ThemeOptionsPanel>("Theme and background", options);
    }
}
