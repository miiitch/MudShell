@page "/components/layouts"
@rendermode InteractiveServer

<PageTitle>Layouts — MudShell</PageTitle>
<MdsFillLayout>
    <Header><ShowcaseHeader FamilyId="layouts" /></Header>
    <Bands>
        <MudStack Row Wrap="Wrap.Wrap" Class="px-4 pb-2">
            <MudButton Href="/examples/workspace">List and preview example</MudButton>
            <MudButton Href="/examples/workspace/detail">Detail page example</MudButton>
        </MudStack>
        <div class="px-4">
            <ShowcaseDetails FamilyId="layouts">
                <p>Header and Bands stay fixed; Body fills the remaining space. Leaf regions handle their own scrolling.</p>
                <MudText Typo="Typo.caption">&lt;MdsFillLayout&gt;
  &lt;Header&gt;...&lt;/Header&gt;
  &lt;Bands&gt;...&lt;/Bands&gt;
  &lt;Body&gt;&lt;MdsSplitPane&gt;...&lt;/MdsSplitPane&gt;&lt;/Body&gt;
&lt;/MdsFillLayout&gt;</MudText>
            </ShowcaseDetails>
        </div>
    </Bands>
    <Body>
        <MdsTabbedFill data-testid="layout-tabs">
            <MudTabPanel>
                <TabContent><MdsTabHeader Text="Panes and scrolling" /></TabContent>
                <ChildContent>
                    <MdsSplitPane StorageKey="showcase.layouts" data-testid="layout-split">
                        <Main>
                            <div class="pa-4">
                                <h2>Main content</h2>
                                <p>Resize the divider. This region scrolls without moving the header or tabs.</p>
                                @for (var i = 1; i <= 70; i++) { <p>Demo row @i</p> }
                            </div>
                        </Main>
                        <Side>
                            <div class="pa-4"><h2>Independent preview</h2>
                                @for (var i = 1; i <= 40; i++) { <p>Additional information @i</p> }
                            </div>
                        </Side>
                    </MdsSplitPane>
                </ChildContent>
            </MudTabPanel>
            <MudTabPanel>
                <TabContent><MdsTabHeader Text="Simple region" /></TabContent>
                <ChildContent>
                    <MdsFillRegion Class="pa-4">
                        <h2>A region that fills its tab</h2>
                        @for (var i = 1; i <= 70; i++) { <p>Simple region row @i</p> }
                    </MdsFillRegion>
                </ChildContent>
            </MudTabPanel>
        </MdsTabbedFill>
    </Body>
</MdsFillLayout>
