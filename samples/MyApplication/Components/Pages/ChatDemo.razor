@page "/chat"
@page "/components/conversation"
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Chat</PageTitle>

<MdsFillLayout>
    <Header>
        <MudStack Spacing="2" Class="px-4">
            <ShowcaseHeader FamilyId="conversation" />
            <ShowcaseDetails FamilyId="conversation">
                <p>Simulated agent, no AI service. Try the suggestions: "usage" renders a custom tool-call chart, "delete" asks for approval, anything else streams text after a reasoning summary.</p>
                <MdsChatBar @bind-Value="_barDemo" Placeholder="Simple input bar example" />
                <MudLink Href="/components/conversation/floating">Try the floating assistant</MudLink>
            </ShowcaseDetails>
        </MudStack>
    </Header>
    <Body>
        <MdsChat Agent="_agent"
                 Greeting="Great to see you again. What's the latest?"
                 Prompts="@_suggestions"
                 MaxLength="500"
                 data-testid="chat-root">
            <InputActions>
                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Inherit" />
            </InputActions>
            <InputEndActions>
                <MudIconButton Icon="@Icons.Material.Filled.GraphicEq" Size="Size.Small" Color="Color.Inherit" />
            </InputEndActions>
            <MessageListContent>
                @* A custom BlockRenderer overrides MudShell's default for the tool calls it matches. *@
                <BlockRenderer TBlock="FunctionInvocationContentBlock" When="@(b => b.ToolName == FakeChatClient.UsageTool)" Context="block">
                    <ChatChartPart Block="block" />
                </BlockRenderer>
            </MessageListContent>
        </MdsChat>
    </Body>
</MdsFillLayout>

@code {
    private static readonly string[] _suggestions =
        ["Show my usage", "Delete the Q3 report", "Explain streaming in Blazor"];

    private string _barDemo = "";
    private readonly UIAgent _agent = new(new FakeChatClient(), options => options.AddMdsReasoning());

    public void Dispose() => _agent.Dispose();
}
