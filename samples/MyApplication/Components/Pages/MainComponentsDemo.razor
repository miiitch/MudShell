@page "/main-components"
@page "/components/composition"
@rendermode InteractiveServer

<PageTitle>Page composition — MudShell</PageTitle>
<MudStack Spacing="3" Class="pa-4" data-testid="composition-demo">
    <ShowcaseHeader FamilyId="composition" />
    <MdsMainToolbar>
        <MudTooltip Text="Add a sample item">
            <MudIconButton Icon="@Icons.Material.Outlined.Add" Variant="Variant.Filled" Color="Color.Primary"
                           aria-label="Add a sample item" data-testid="composition-add" OnClick="@(() => _counter++)" />
        </MudTooltip>
        <MdsMainToolbarDivider />
        <MudTooltip Text="Reset the demo">
            <MudIconButton Icon="@Icons.Material.Outlined.Refresh" aria-label="Reset the demo"
                           data-testid="composition-reset" OnClick="@Reset" />
        </MudTooltip>
        <MudSpacer />
        <span data-testid="composition-count">Items added: @_counter</span>
    </MdsMainToolbar>
    <MudGrid>
        <MudItem xs="12" lg="8">
            <MdsMainSection Title="Recent documents" Description="A title, a description and structured content."
                            IsLoading="@(_state == "loading")" data-testid="composition-documents">
                @if (_state == "error")
                {
                    <MudAlert Severity="Severity.Error">
                        Simulated error: unable to load documents.
                        <div class="mt-2">
                            <MdsMainButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="@ResetState">
                                Retry
                            </MdsMainButton>
                        </div>
                    </MudAlert>
                }
                else if (_state == "empty")
                {
                    <MdsMainEmptyState Title="No documents" Description="Add an item to get started.">
                        <Action><MdsMainButton OnClick="@AddFirst">Add a sample document</MdsMainButton></Action>
                    </MdsMainEmptyState>
                }
                else
                {
                    <p>Project overview</p><p>Summary report</p><p>Meeting notes</p>
                }
            </MdsMainSection>
            <MdsMainSection Title="Statuses">
                <MudStack Row Wrap="Wrap.Wrap">
                    <MdsMainStatusBadge Label="Active" Status="active" />
                    <MdsMainStatusBadge Label="Pending" Status="pending" />
                    <MdsMainStatusBadge Label="Error" Status="error" />
                </MudStack>
            </MdsMainSection>
        </MudItem>
        <MudItem xs="12" lg="4">
        <MdsMainSection Title="Try the states">
            <MudSelect T="string" Label="Section state" @bind-Value="_state" data-testid="composition-state">
                <MudSelectItem Value="@("content")">Content</MudSelectItem>
                <MudSelectItem Value="@("loading")">Simulated loading</MudSelectItem>
                <MudSelectItem Value="@("empty")">No results</MudSelectItem>
                <MudSelectItem Value="@("error")">Simulated error</MudSelectItem>
            </MudSelect>
            <p>These controls affect the demo, not the showcase appearance.</p>
        </MdsMainSection>
        </MudItem>
    </MudGrid>
    <ShowcaseDetails FamilyId="composition">
        <MudText Typo="Typo.caption">&lt;MdsMainSection Title="Results" IsLoading="loading"&gt;...&lt;/MdsMainSection&gt;</MudText>
        <p>The toolbar contains actions. List page filters belong on a separate row.</p>
    </ShowcaseDetails>
</MudStack>

@code {
    private int _counter;
    private string _state = "content";
    private void ResetState() => _state = "content";
    private void Reset() { _counter = 0; ResetState(); }
    private void AddFirst() { _counter++; ResetState(); }
}
