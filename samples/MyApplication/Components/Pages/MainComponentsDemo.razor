@page "/main-components"
@page "/components/composition"
@rendermode InteractiveServer

<PageTitle>Composition de page — MudShell</PageTitle>
<div class="showcase-page" data-testid="composition-demo">
    <ShowcaseHeader FamilyId="composition" />
    <MdsMainToolbar>
        <MudTooltip Text="Ajouter un élément fictif">
            <MudIconButton Icon="@Icons.Material.Outlined.Add" Variant="Variant.Filled" Color="Color.Primary"
                           aria-label="Ajouter un élément fictif" data-testid="composition-add" OnClick="@(() => _counter++)" />
        </MudTooltip>
        <MdsMainToolbarDivider />
        <MudTooltip Text="Réinitialiser la démonstration">
            <MudIconButton Icon="@Icons.Material.Outlined.Refresh" aria-label="Réinitialiser la démonstration"
                           data-testid="composition-reset" OnClick="@Reset" />
        </MudTooltip>
        <MudSpacer />
        <span data-testid="composition-count">@_counter éléments ajoutés</span>
    </MdsMainToolbar>
    <div class="showcase-demo-grid">
        <div>
            <MdsMainSection Title="Documents récents" Description="Un titre, une description et un contenu hiérarchisé.">
                <MdsMainPart Title="Résultats" IsLoading="@(_state == "loading")"
                             Error="@(_state == "error" ? "Erreur simulée : impossible de charger les documents." : null)"
                             OnRetry="@ResetState">
                    @if (_state == "empty")
                    {
                        <MdsMainEmptyState Title="Aucun document" Description="Ajoutez un élément pour commencer.">
                            <Action><MdsMainButton OnClick="@AddFirst">Ajouter un document fictif</MdsMainButton></Action>
                        </MdsMainEmptyState>
                    }
                    else
                    {
                        <p>Présentation du projet</p><p>Rapport de synthèse</p><p>Notes de réunion</p>
                    }
                </MdsMainPart>
            </MdsMainSection>
            <MdsMainSection Title="Statuts">
                <MudStack Row Wrap="Wrap.Wrap">
                    <MdsMainStatusBadge Label="Actif" Status="active" />
                    <MdsMainStatusBadge Label="En attente" Status="pending" />
                    <MdsMainStatusBadge Label="Erreur" Status="error" />
                </MudStack>
            </MdsMainSection>
        </div>
        <aside class="showcase-controls">
            <h2>Essayer les états</h2>
            <MudSelect T="string" Label="État de la section" @bind-Value="_state" data-testid="composition-state">
                <MudSelectItem Value="@("content")">Contenu</MudSelectItem>
                <MudSelectItem Value="@("loading")">Chargement simulé</MudSelectItem>
                <MudSelectItem Value="@("empty")">Aucun résultat</MudSelectItem>
                <MudSelectItem Value="@("error")">Erreur simulée</MudSelectItem>
            </MudSelect>
            <p>Ces commandes pilotent la démo, pas l’apparence de la vitrine.</p>
        </aside>
    </div>
    <ShowcaseDetails FamilyId="composition">
        <pre>&lt;MdsMainPart Title="Résultats" IsLoading="loading" Error="error" OnRetry="Reload"&gt;...&lt;/MdsMainPart&gt;</pre>
        <p>La toolbar contient les actions. Les filtres d’une page de liste se placent sur une ligne distincte.</p>
    </ShowcaseDetails>
</div>

@code {
    private int _counter;
    private string _state = "content";
    private void ResetState() => _state = "content";
    private void Reset() { _counter = 0; ResetState(); }
    private void AddFirst() { _counter++; ResetState(); }
}
