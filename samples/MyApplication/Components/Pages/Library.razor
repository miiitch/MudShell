@page "/library"
@rendermode InteractiveServer

<PageTitle>Bibliothèque</PageTitle>

<MdsPageHeader Title="Bibliothèque">
    <StartContent><div></div></StartContent>
    <EndContent>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">Créer une page</MudButton>
    </EndContent>
</MdsPageHeader>

<MudStack AlignItems="AlignItems.Center" Class="px-4 py-2">
    <MdsFilterTabBar T="string" @bind-Value="_selectedTab"
                     Items="@_tabs">
        <TrailingContent>
            <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" Color="Color.Inherit" />
        </TrailingContent>
    </MdsFilterTabBar>
</MudStack>

@if (_selectedTab == "pages")
{
    <MudGrid Spacing="3" Class="px-4">
        @foreach (var doc in _pages)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MdsDocumentCard Icon="@Icons.Material.Outlined.Description"
                                 TypeLabel="Page"
                                 Title="@doc.Title"
                                 Description="@doc.Description" />
            </MudItem>
        }
    </MudGrid>
}

<MudStack AlignItems="AlignItems.Center" Class="pa-8">
    <MudText Typo="Typo.h5" Align="Align.Center">
        Organisez vos idées, modifiez<br />et partagez vos documents
    </MudText>
    <MudButton Variant="Variant.Filled" Size="Size.Large">
        Créer une page
    </MudButton>
</MudStack>

@code {
    private string _selectedTab = "pages";

    private readonly MbxTabItem<string>[] _tabs =
    [
        new("images",   "Images"),
        new("pages",    "Pages"),
        new("rapports", "Rapports de recherche"),
    ];

    private readonly List<PageItem> _pages =
    [
        new("Things to do in Tokyo",
            "Tokyo offers a vibrant mix of traditional culture and modern attractions. Here are some highlights to consider during your..."),
        new("Cover Letter Draft",
            "Dear [Hiring Manager], I am writing to express my interest in the [Position]. [Company Name]..."),
        new("History Class Essay",
            "The Industrial Revolution, which began in the late 18th century and continued into the mid-19th century, fundamentally..."),
        new("Poem Draft",
            "In morning light, the city wakes, With fog that dances, swirls and breaks. Cobalt skies emerge above...")
    ];

    private record PageItem(string Title, string Description);
}
