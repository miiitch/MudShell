@namespace MudShell.Components.BottomNav
@using Microsoft.AspNetCore.Components.Routing
@using MudShell.Components.Sidebar

<div class="@RootClass" style="@Style" @attributes="AdditionalAttributes">
    @foreach (var item in Items ?? [])
    {
        @if (!string.IsNullOrWhiteSpace(item.Href))
        {
            var isForcedActive = string.Equals(item.Href, ActiveHref, StringComparison.OrdinalIgnoreCase);
            var navClass = $"mbx-bottom-nav-item {(isForcedActive ? "mbx-bottom-nav-item-active" : string.Empty)}".Trim();
            <NavLink href="@item.Href"
                     Match="NavLinkMatch.Prefix"
                     class="@navClass"
                     ActiveClass="mbx-bottom-nav-item-active">
                <MudIcon Icon="@item.Icon" Size="Size.Small" />
                <span class="mbx-bottom-nav-label">@item.Label</span>
            </NavLink>
        }
        else
        {
            <button type="button" class="mbx-bottom-nav-item" disabled>
                <MudIcon Icon="@item.Icon" Size="Size.Small" />
                <span class="mbx-bottom-nav-label">@item.Label</span>
            </button>
        }
    }
</div>

@code {
    /// <summary>Undeclared attributes, splatted onto the root element (e.g. <c>data-testid</c>, ARIA attributes).</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter] public MbxNavItem[]? Items     { get; set; }
    [Parameter] public string?       ActiveHref { get; set; }
    [Parameter] public string?       Class      { get; set; }
    [Parameter] public string?       Style      { get; set; }

    private string RootClass => $"mbx-bottom-nav {Class}".Trim();
}
