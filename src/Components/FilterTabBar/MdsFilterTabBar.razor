@namespace MudShell.Components.FilterTabBar
@typeparam T

<div class="@RootClass" @attributes="AdditionalAttributes">
    <MudToggleGroup T="T" Value="Value" ValueChanged="ValueChanged"
                    Color="Color.Primary" CheckMark="false"
                    Style="gap: 4px;">
        @foreach (var item in Items ?? [])
        {
            <MudToggleItem Value="@item.Value" Text="@item.Label" />
        }
    </MudToggleGroup>
    @if (TrailingContent is not null)
    {
        @TrailingContent
    }
</div>

@code {
    [Parameter] public T?                          Value           { get; set; }
    [Parameter] public EventCallback<T>            ValueChanged    { get; set; }
    [Parameter] public IEnumerable<MbxTabItem<T>>? Items          { get; set; }
    [Parameter] public RenderFragment?             TrailingContent { get; set; }
    [Parameter] public string?                     Class          { get; set; }

    /// <summary>
    /// Undeclared attributes, forwarded to the root element. Without this, passing an attribute the
    /// component does not declare (a <c>data-testid</c> for end-to-end tests, an ARIA attribute)
    /// fails at render time rather than being ignored.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string RootClass => $"mbx-filter-tabs {Class}".Trim();
}
