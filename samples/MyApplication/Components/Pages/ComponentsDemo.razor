@page "/demo"
@rendermode InteractiveServer
@using MudShell.Components.Navigation
@using MudShell.Components.Navigation.Models

<PageTitle>Components Demo</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="px-4 pb-4 pt-0">
@* ── Header ─────────────────────────────────────────────────────────── *@
<MdsPageHeader Title="Design System — Showcase">
    <StartContent><div></div></StartContent>
    <EndContent>
        <MudChip T="string" Color="Color.Primary" Size="Size.Small">MudShell</MudChip>
    </EndContent>
</MdsPageHeader>

<MudStack Spacing="6" Class="pb-2">
    @* ── Section : ChatBar ──────────────────────────────────────────── *@
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6" Class="mds-u-section-title">MdsChatBar</MudText>
        <MudStack Spacing="1" AlignItems="AlignItems.Center">
            <MdsChatBar Placeholder="@("Message Copilot or @mention a tab")"
                        @bind-Value="_chatValue">
                <Actions>
                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Inherit" />
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" Size="Size.Small"
                               EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                               Class="text-none">Smart</MudButton>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Filled.GraphicEq" Size="Size.Small" Color="Color.Inherit" />
                </Actions>
            </MdsChatBar>
            @if (!string.IsNullOrEmpty(_chatValue))
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">Value: @_chatValue</MudText>
            }
        </MudStack>
    </MudStack>

    @* ── Section : FilterTabBar ─────────────────────────────────────── *@
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6" Class="mds-u-section-title">MdsFilterTabBar</MudText>
        <MdsFilterTabBar T="string" @bind-Value="_selectedTab" Items="@_tabs" />
        <MudText Typo="Typo.caption" Color="Color.Secondary">Active tab: @_selectedTab</MudText>
    </MudStack>

    @* ── Section : DocumentCard ─────────────────────────────────────── *@
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6" Class="mds-u-section-title">MdsDocumentCard</MudText>
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MdsDocumentCard Icon="@Icons.Material.Outlined.Description"
                                 TypeLabel="Page"
                                 Title="Things to do in Tokyo"
                                 Description="Tokyo offers a vibrant mix of traditional culture and modern attractions." />
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MdsDocumentCard Icon="@Icons.Material.Outlined.Image"
                                 TypeLabel="Image"
                                 Title="Project preview"
                                 Description="High-fidelity mockup for the app home page." />
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MdsDocumentCard Icon="@Icons.Material.Outlined.BarChart"
                                 TypeLabel="Report"
                                 Title="Q3 2024 report"
                                 Description="Analysis of user engagement metrics for the quarter." />
            </MudItem>
        </MudGrid>
    </MudStack>

    @* ── Section : MdsSidebarNav — sub-menu pinning & sorting ───────── *@
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6" Class="mds-u-section-title">MdsSidebarNav — épingler / retirer / trier un sous-menu</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            "Épinglé en tête" et "Épinglé en fin" restent immobiles. Les items du milieu se
            glissent-déposent pour changer d'ordre, et l'icône épingle retire l'item de la liste.
        </MudText>
        <MudGrid Spacing="3">
            <MudItem xs="12" md="4">
                @* Same shell classes MdsSidebar itself renders (.mbx-nav.mbx-nav-expanded) + the
                   drawer background variable, so this reads as an actual sidebar rail rather than
                   an arbitrary card. *@
                <div class="mbx-nav mbx-nav-expanded"
                     style="width:260px; height:360px; background:var(--mud-palette-drawer-background, var(--mud-palette-surface)); border-radius:var(--mbx-radius-md); border:1px solid var(--mbx-content-border); padding-top:var(--mbx-space-2);">
                    <MdsSidebarNav Tree="@_sortDemoTree" IsExpanded="true" OnSortChanged="@HandleSortDemoSortChanged" />
                </div>
            </MudItem>
            <MudItem xs="12" md="8">
                <MudSimpleTable Dense="true" Hover="true" data-testid="sidebar-nav-sort-demo-log">
                    <thead>
                        <tr><th>Événement</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in _sortDemoLog)
                        {
                            <tr><td>@entry</td></tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudItem>
        </MudGrid>
    </MudStack>

    @* ── Section : PageHeader variants ─────────────────────────────── *@
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6" Class="mds-u-section-title">MdsPageHeader</MudText>
        <MudPaper Outlined="true" Class="mds-u-surface-wrap">
            <MudStack Spacing="0">
            <MdsPageHeader Title="Simple page title" />
            <MdsPageHeader Title="With action">
                <StartContent><div></div></StartContent>
                <EndContent>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               Class="text-none">Action</MudButton>
                </EndContent>
            </MdsPageHeader>
            </MudStack>
        </MudPaper>
    </MudStack>

    @* ── Section : Responsive note ──────────────────────────────────── *@
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6" Class="mds-u-section-title">Desktop breakpoints</MudText>
        <MudSimpleTable Dense="true" Hover="true">
            <thead>
                <tr>
                    <th>Alias</th><th>Width</th><th>Sidebar</th>
                </tr>
            </thead>
            <tbody>
                <tr><td>md</td><td>960 – 1279 px</td><td>icon-only</td></tr>
                <tr><td>lg+</td><td>≥ 1280 px</td><td>icon-only / expanded</td></tr>
            </tbody>
        </MudSimpleTable>
    </MudStack>

</MudStack>
</MudContainer>

@code {
    private string _chatValue = string.Empty;
    private string _selectedTab = "pages";

    private readonly MbxTabItem<string>[] _tabs =
    [
        new("images",   "Images"),
        new("pages",    "Pages"),
        new("reports", "Research reports"),
        new("videos",  "Videos"),
    ];

    // ── MdsSidebarNav sub-menu pinning & sorting demo ──────────────────
    private readonly List<string> _sortDemoLog = [];
    private List<string> _sortDemoOrder = ["report-alpha", "report-beta", "report-gamma"];
    private readonly HashSet<string> _sortDemoRemoved = [];

    private MbxNavTree _sortDemoTree => new(
    [
        new(
            id: "sort-demo-section",
            text: "Rapports",
            icon: Icons.Material.Outlined.Folder,
            defaultExpanded: true,
            children: BuildSortDemoChildren())
    ]);

    private List<MbxNavNode> BuildSortDemoChildren()
    {
        var children = new List<MbxNavNode>
        {
            new(id: "report-pinned-top", text: "Épinglé en tête", pin: MbxNavPin.Top),
        };

        foreach (var id in _sortDemoOrder)
        {
            if (_sortDemoRemoved.Contains(id))
                continue;

            children.Add(new(
                id: id,
                text: id,
                pin: MbxNavPin.None,
                trailingActions:
                [
                    new MbxNavAction(
                        Icons.Material.Outlined.PushPin,
                        "Retirer de la liste",
                        EventCallback.Factory.Create<string>(this, HandleSortDemoRemove))
                ]));
        }

        children.Add(new(id: "report-pinned-bottom", text: "Épinglé en fin", pin: MbxNavPin.Bottom));
        return children;
    }

    private void HandleSortDemoSortChanged(MbxNavSortChangedArgs args)
    {
        _sortDemoOrder = args.OrderedIds.ToList();
        _sortDemoLog.Insert(0, $"OnSortChanged → [{string.Join(", ", args.OrderedIds)}]");
        StateHasChanged();
    }

    private void HandleSortDemoRemove(string id)
    {
        _sortDemoRemoved.Add(id);
        _sortDemoLog.Insert(0, $"Retiré : {id}");
        StateHasChanged();
    }
}
