@page "/meteo"
@rendermode InteractiveServer
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.False" Class="px-4 pb-4 pt-0">

    <MdsPageHeader Title="Weather"
                   Icon="@Icons.Material.Outlined.Cloud"
                   BreadcrumbItems="@_breadcrumbs">
        <HeaderActions>
            <MudIconButton Icon="@Icons.Material.Outlined.ColorLens"
                           Size="Size.Small"
                           Color="Color.Inherit"
                           title="Theme and background"
                           OnClick="@OpenThemeDialog" />
        </HeaderActions>
    </MdsPageHeader>

    <MdsMainToolbar>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Outlined.RestartAlt"
                   OnClick="@ResetFilters">Reset filters</MudButton>
        <MudSpacer />
        <MudSwitch T="bool" @bind-Value="_isDense" Color="Color.Primary" Label="Dense table" />
    </MdsMainToolbar>

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="MudBlazor.Wrap.Wrap" Class="mb-3">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Period</MudText>
            <MudChip T="string"
                     Color="@(_selectedPeriod == "today" ? Color.Primary : Color.Default)"
                     Variant="@(_selectedPeriod == "today" ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => _selectedPeriod = "today")">Today</MudChip>
            <MudChip T="string"
                     Color="@(_selectedPeriod == "week" ? Color.Primary : Color.Default)"
                     Variant="@(_selectedPeriod == "week" ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => _selectedPeriod = "week")">This week</MudChip>
            <MudChip T="string"
                     Color="@(_selectedPeriod == "month" ? Color.Primary : Color.Default)"
                     Variant="@(_selectedPeriod == "month" ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => _selectedPeriod = "month")">This month</MudChip>

            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2">City</MudText>
            <MudChip T="string"
                     Color="@(_selectedCity == "Paris" ? Color.Primary : Color.Default)"
                     Variant="@(_selectedCity == "Paris" ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => _selectedCity = "Paris")">Paris</MudChip>
            <MudChip T="string"
                     Color="@(_selectedCity == "Lyon" ? Color.Primary : Color.Default)"
                     Variant="@(_selectedCity == "Lyon" ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => _selectedCity = "Lyon")">Lyon</MudChip>
            <MudChip T="string"
                     Color="@(_selectedCity == "Marseille" ? Color.Primary : Color.Default)"
                     Variant="@(_selectedCity == "Marseille" ? Variant.Filled : Variant.Outlined)"
                     OnClick="@(() => _selectedCity = "Marseille")">Marseille</MudChip>
    </MudStack>

    <MdsMainPart Title="Summary" Icon="@Icons.Material.Outlined.WbSunny">
        <MudGrid Spacing="3">
            @foreach (var tile in _tiles)
            {
                <MudItem xs="12" sm="6" md="3">
                    <MudStack AlignItems="AlignItems.Start" Spacing="1"
                              Style="background:var(--mud-palette-background-grey); border-radius:8px;"
                              Class="pa-3">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@tile.Icon" Size="Size.Small" Color="Color.Secondary" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@tile.Label</MudText>
                        </MudStack>
                        <MudText Typo="Typo.h4" Color="@tile.ValueColor">@tile.Value</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@tile.Sub</MudText>
                    </MudStack>
                </MudItem>
            }
        </MudGrid>
    </MdsMainPart>

    <MdsMainPart Title="Hourly forecast" Icon="@Icons.Material.Outlined.Schedule">
        <MudTable T="HourlyRow" Items="@_hourly" Hover="true" Dense="@_isDense" Elevation="0">
            <HeaderContent>
                <MudTh>Time</MudTh>
                <MudTh>Conditions</MudTh>
                <MudTh>Temp (°C)</MudTh>
                <MudTh>Vent (km/h)</MudTh>
                <MudTh>Humidity</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Time">@context.Hour</MudTd>
                <MudTd DataLabel="Conditions">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@context.Icon" Size="Size.Small" />
                        <MudText Typo="Typo.body2">@context.Condition</MudText>
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="Temp">
                    <MudText Color="@(context.Temp >= 25 ? Color.Warning : context.Temp <= 5 ? Color.Info : Color.Default)">
                        @context.Temp°
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Wind">@context.Wind</MudTd>
                <MudTd DataLabel="Humidity">
                    <MudChip T="string" Size="Size.Small"
                             Color="@(context.Humidity >= 80 ? Color.Info : Color.Default)"
                             Variant="Variant.Text">@context.Humidity%</MudChip>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="[8, 24]" />
            </PagerContent>
        </MudTable>
    </MdsMainPart>

</MudContainer>

@code {
    private string _selectedPeriod = "today";
    private string _selectedCity = "Paris";
    private bool _isDense = true;

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Home", href: "/"),
        new("Weather", href: null, disabled: true)
    ];

    private readonly TileItem[] _tiles =
    [
        new(Icons.Material.Outlined.Thermostat, "Temperature", "23°C",    "Feels like 21°C",        Color.Warning),
        new(Icons.Material.Outlined.WaterDrop,  "Humidity",    "60%",     "Normal for the season",   Color.Info),
        new(Icons.Material.Outlined.Air,         "Wind",        "12 km/h", "Direction SW",          Color.Default),
        new(Icons.Material.Outlined.LightMode,  "UV index",    "4",       "Moderate",              Color.Success),
    ];

    private static readonly HourlyRow[] _hourly =
    [
        new("08:00", Icons.Material.Outlined.WbSunny,      "Sunny",        18, 8,  52),
        new("09:00", Icons.Material.Outlined.WbSunny,      "Sunny",        19, 9,  50),
        new("10:00", Icons.Material.Outlined.WbSunny,      "Sunny",        20, 10, 48),
        new("11:00", Icons.Material.Outlined.WbCloudy,     "Cloudy",       21, 12, 50),
        new("12:00", Icons.Material.Outlined.WbCloudy,     "Cloudy",       23, 14, 54),
        new("13:00", Icons.Material.Outlined.WbSunny,      "Sunny",        24, 13, 53),
        new("14:00", Icons.Material.Outlined.WbSunny,      "Sunny",        25, 12, 51),
        new("15:00", Icons.Material.Outlined.Cloud,        "Overcast",     23, 15, 57),
        new("16:00", Icons.Material.Outlined.Cloud,        "Overcast",     22, 16, 60),
        new("17:00", Icons.Material.Outlined.Thunderstorm, "Stormy",       20, 20, 72),
        new("18:00", Icons.Material.Outlined.Umbrella,     "Light rain",   19, 18, 78),
        new("19:00", Icons.Material.Outlined.WbTwilight,   "Clear spells", 18, 14, 70),
    ];

    private sealed record TileItem(string Icon, string Label, string Value, string Sub, Color ValueColor);
    private sealed record HourlyRow(string Hour, string Icon, string Condition, int Temp, int Wind, int Humidity);

    private void ResetFilters()
    {
        _selectedPeriod = "today";
        _selectedCity = "Paris";
    }

    private async Task OpenThemeDialog()
    {
        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        await DialogService.ShowAsync<ThemeOptionsPanel>("Theme and background", options);
    }
}
