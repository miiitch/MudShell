@namespace MudShell.Components.Navigation
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@using MudShell.Components.Navigation.Models
@using MudShell.Components.Navigation.State
@inject NavigationManager Nav

<div class="mbx-context-nav-panel @(IsExpanded ? "mbx-context-nav-panel-expanded" : "mbx-context-nav-panel-collapsed") @Class" @attributes="AdditionalAttributes">
    @if (_state.ContextPanelNodes.Count == 0)
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="pa-2">No contextual navigation</MudText>
    }
    else if (!IsExpanded)
    {
        @foreach (var node in _state.ContextPanelNodes)
        {
            var icon = !string.IsNullOrWhiteSpace(node.Icon) ? node.Icon : Icons.Material.Outlined.Circle;
            var isActiveL2 = _state.ActivePath.Contains(node.Id);
            var collapsedLinkClass = $"mbx-context-collapsed-link{(isActiveL2 ? " mbx-context-collapsed-link-active" : "")}";
            <MudTooltip Text="@node.Text" Placement="Placement.Right">
                @if (!string.IsNullOrWhiteSpace(node.Href) && !node.Disabled)
                {
                    <NavLink href="@node.Href"
                             Match="@ToNavLinkMatch(node.Match)"
                             class="@collapsedLinkClass"
                             title="@node.Text">
                        <MudIcon Icon="@icon" Size="Size.Small" />
                    </NavLink>
                }
                else
                {
                    <MudIconButton Icon="@icon"
                                   Size="Size.Small"
                                   Color="Color.Inherit"
                                   Disabled="@node.Disabled"
                                   OnClick="@(() => HandleLevel2Click(node))" />
                }
            </MudTooltip>
        }
    }
    else
    {
        <MudNavMenu Color="Color.Primary" Rounded="true" Dense="true" Class="mbx-context-mud-nav">
            @foreach (var node in _state.ContextPanelNodes)
            {
                var hasChildren = node.Children.Count > 0;
                var isExpanded = _state.ExpandedNodeIds.Contains(node.Id);

                @if (hasChildren)
                {
                    <MudNavGroup data-testid="@MudShell.MbxTestId.NavGroup(node.Id)"
                                 Title="@node.Text"
                                 Icon="@(node.Icon ?? Icons.Material.Outlined.Circle)"
                                 IconColor="Color.Inherit"
                                 Expanded="@isExpanded"
                                 ExpandedChanged="@(v => HandleGroupExpandedChanged(node, v))"
                                 Class="mbx-context-nav-group">
                        @foreach (var child in node.Children.Where(c => c.Visible))
                        {
                            <MudNavLink data-testid="@MudShell.MbxTestId.Nav(child.Id)"
                                        Href="@child.Href"
                                        Disabled="@child.Disabled"
                                        ActiveClass=""
                                        Class="@(_state.ActivePath.Contains(child.Id) ? "mbx-context-nav-active" : "")"
                                        Match="NavLinkMatch.All">
                                @child.Text
                            </MudNavLink>
                        }
                    </MudNavGroup>
                }
                else
                {
                    <MudNavLink data-testid="@MudShell.MbxTestId.Nav(node.Id)"
                                Href="@node.Href"
                                Icon="@(node.Icon ?? Icons.Material.Outlined.Circle)"
                                IconColor="Color.Inherit"
                                Disabled="@node.Disabled"
                                ActiveClass=""
                                Class="@(_state.ActivePath.Contains(node.Id) ? "mbx-context-nav-active" : "")"
                                Match="NavLinkMatch.All">
                        @node.Text
                    </MudNavLink>
                }
            }
        </MudNavMenu>
    }
</div>

@code {
    /// <summary>Undeclared attributes, splatted onto the root element (e.g. <c>data-testid</c>, ARIA attributes).</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter] public MbxNavTree? Tree              { get; set; }
    [Parameter] public string? CurrentUri            { get; set; }
    [Parameter] public bool SingleExpandedLevel2     { get; set; } = true;
    [Parameter] public bool IsExpanded               { get; set; } = true;
    [Parameter] public string? Class                 { get; set; }

    private MbxNavState _state = MbxNavState.Empty;
    private HashSet<string> _expanded = new(StringComparer.Ordinal);

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        RecomputeState();
    }

    protected override void OnParametersSet() => RecomputeState();

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        RecomputeState();
        InvokeAsync(StateHasChanged);
    }

    private void RecomputeState()
    {
        _state = MbxNavStateResolver.Resolve(
            Tree,
            CurrentUri ?? Nav.Uri,
            _expanded,
            singleExpandLevel2: SingleExpandedLevel2);
    }

    private void HandleGroupExpandedChanged(MbxNavNode node, bool isExpanded)
    {
        if (SingleExpandedLevel2 && isExpanded)
        {
            _expanded.RemoveWhere(id => _state.ContextPanelNodes.Any(n => n.Id == id && n.Children.Count > 0));
        }

        if (isExpanded) _expanded.Add(node.Id);
        else _expanded.Remove(node.Id);

        if (!string.IsNullOrWhiteSpace(node.Href))
            Nav.NavigateTo(node.Href);

        RecomputeState();
    }

    private void HandleLevel2Click(MbxNavNode node)
    {
        if (node.Disabled) return;
        if (!string.IsNullOrWhiteSpace(node.Href))
            Nav.NavigateTo(node.Href);
        RecomputeState();
    }

    private static NavLinkMatch ToNavLinkMatch(MbxNavMatchMode mode) =>
        mode == MbxNavMatchMode.All ? NavLinkMatch.All : NavLinkMatch.Prefix;

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
