@page "/modes/ssr/bg"

<PageTitle>Static SSR — Active background</PageTitle>

<MdsPageHeader Title="Static SSR — Background image">
    <StartContent><div></div></StartContent>
    <EndContent>
        <MudStack Row="true" Spacing="1" Class="mds-u-chip-row">
            <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined">No active circuit</MudChip>
            <MudChip T="string" Color="Color.Primary" Size="Size.Small">Active background 🖼</MudChip>
        </MudStack>
    </EndContent>
</MdsPageHeader>

<MudStack Spacing="4" Class="px-4 pb-6">

    <MudPaper Outlined="true" Class="pa-4">
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Start">
            <MudIcon Icon="@Icons.Material.Outlined.Wallpaper" Size="Size.Small" />
            <MudText Typo="Typo.body2">
                Same page in <strong>Static SSR</strong>, with the <strong>background image enabled</strong>.
                The background is automatically activated by the layout when the route ends with <code>/bg</code>.
            </MudText>
        </MudStack>
    </MudPaper>

    <MudStack Spacing="2">
        <MudText Typo="Typo.subtitle1" Class="mds-u-section-title">MdsChatBar (static)</MudText>
        <MdsChatBar Placeholder="@("Static render - events do not work")" />
    </MudStack>

    <MudStack Spacing="2">
        <MudText Typo="Typo.subtitle1" Class="mds-u-section-title">MdsDocumentCard (static)</MudText>
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6" md="4">
                <MdsDocumentCard Icon="@Icons.Material.Outlined.Description"
                                 TypeLabel="Page"
                                 Title="Things to do in Tokyo"
                                 Description="Tokyo offers a vibrant mix of traditional culture and modern attractions." />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MdsDocumentCard Icon="@Icons.Material.Outlined.BarChart"
                                 TypeLabel="Report"
                                 Title="Q3 report"
                                 Description="Engagement metrics analysis for the quarter." />
            </MudItem>
        </MudGrid>
    </MudStack>

    <MudStack Spacing="2">
        <MudText Typo="Typo.subtitle1" Class="mds-u-section-title">MdsPageHeader (static)</MudText>
        <MudPaper Outlined="true" Class="mds-u-surface-wrap">
            <MdsPageHeader Title="Page title">
                <StartContent><div></div></StartContent>
                <EndContent>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               disabled>
                        Action (disabled)
                    </MudButton>
                </EndContent>
            </MdsPageHeader>
        </MudPaper>
    </MudStack>

</MudStack>
