@inject ThemeState ThemeState
@using MudShell.Components.Navigation.Models

@* On mobile the level-1 bar is rendered by MainLayout (MdsBottomNav), so the rail is not rendered here. *@
@if (ShellMode != MdsAppShell.MbxShellMode.Mobile)
{
    <MdsSidebar IsExpanded="@(IsExpanded && ShellMode == MdsAppShell.MbxShellMode.Desktop)"
                OnToggle="@HandleToggle"
                OnItemClick="@HandleItemClick"
                Tree="@Tree">

        <LogoContent>
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Medium" Color="Color.Primary" />
            @if (IsExpanded)
            {
                <MudText Typo="Typo.h6">Copilot</MudText>
            }
        </LogoContent>

        <BottomContent>
            <MudAvatar Size="Size.Small">
                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
            </MudAvatar>
            <ThemeActions />
            @if (IsExpanded)
            {
                <MudStack Spacing="0">
                    <MudText Typo="Typo.body2">Michel</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Microsoft 365</MudText>
                </MudStack>
            }
        </BottomContent>

    </MdsSidebar>
}

@code {
    [Parameter] public MdsAppShell? ShellRef    { get; set; }

    /// <summary>The single navigation source: its roots are the rail entries.</summary>
    [Parameter] public MbxNavTree? Tree         { get; set; }
    [Parameter] public bool          IsExpanded  { get; set; }
    [Parameter] public MdsAppShell.MbxShellMode ShellMode { get; set; } = MdsAppShell.MbxShellMode.Desktop;

    // Desktop: the rail toggle expands the sidebar. Tablet: it opens the level-2 overlay instead,
    // because the rail has no expanded mode there.
    private void HandleToggle()
    {
        if (ShellMode == MdsAppShell.MbxShellMode.Desktop) ShellRef?.ToggleSidebar();
        else ShellRef?.ToggleContextPanel();
    }

    // Tablet: tapping a rail icon opens the level-2 overlay for that section (the page it navigates to).
    private void HandleItemClick(MbxNavItem item) => ShellRef?.OpenContextPanelOnNextNavigation();
}
