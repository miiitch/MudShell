@page "/components"
@rendermode InteractiveServer

<PageTitle>Composants — MudShell</PageTitle>
<div class="showcase-page" data-testid="showcase-catalog">
    <MdsPageHeader Title="Trouvez la bonne brique." BreadcrumbItems="@_breadcrumbs" />
    <p>Une entrée par usage. Chaque composant reste identifiable par son nom.</p>
    <MudTextField T="string" Value="@_query" ValueChanged="@(value => _query = value)" Immediate
                  Label="Rechercher une famille ou un composant" data-testid="catalog-search" Class="mb-5" />
    <div class="showcase-cards">
        @foreach (var family in Matches)
        {
            <a class="showcase-card" href="@family.Href" data-testid="@($"catalog-family-{family.Id}")">
                <MudIcon Icon="@family.Icon" Color="Color.Primary" />
                <h2>@family.Title</h2><p>@family.Description</p>
                <div class="showcase-component-list">
                    @foreach (var component in family.Components)
                    {
                        <code>@component</code>
                    }
                </div>
            </a>
        }
    </div>
    @if (!Matches.Any())
    {
        <MdsMainEmptyState Title="Aucun composant ne correspond" Description="Essayez un nom de composant ou un autre usage." />
    }
</div>

@code {
    private string _query = "";
    private readonly List<BreadcrumbItem> _breadcrumbs = [new("Accueil", "/")];
    private IEnumerable<ShowcaseCatalog.Family> Matches => ShowcaseCatalog.Families.Where(f =>
        $"{f.Title} {f.Description} {string.Join(" ", f.Components)}".Contains(_query, StringComparison.OrdinalIgnoreCase));
}
