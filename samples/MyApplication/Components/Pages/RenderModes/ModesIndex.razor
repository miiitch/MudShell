@page "/modes"
@rendermode InteractiveServer
@inject NavigationManager Nav

<PageTitle>Render Modes</PageTitle>

<MdsPageHeader Title="Render Modes">
    <StartContent><div></div></StartContent>
    <EndContent>
        <MudChip T="string" Color="Color.Default" Size="Size.Small">4 modes × variantes</MudChip>
    </EndContent>
</MdsPageHeader>

<MudStack Spacing="3" Class="px-4 pb-6">
    <MudText Typo="Typo.body1" Color="Color.Secondary">
        Cette section démontre que la bibliothèque <strong>MudShell</strong> fonctionne
        quel que soit le mode de rendu Blazor. Chaque mode propose deux variantes :
        fond <strong>palette</strong> (sombre uni), fond <strong>image</strong>,
        <strong>grid</strong> et <strong>table</strong> (sans scroll de page).
    </MudText>

    <MudGrid Spacing="3">

        @foreach (var mode in _modes)
        {
            var bgRoute    = mode.Route + "/bg";
            var gridRoute  = mode.Route + "/grid";
            var tableRoute = mode.Route + "/table";
            var fl         = mode.NeedsFullReload;

            <MudItem xs="12" sm="6" md="3">
                <MudPaper Outlined="true" Class="pa-3">
                    <MudStack Spacing="2">
                        <MudAvatar Variant="Variant.Outlined" Color="Color.Default" Size="Size.Large">
                            <MudIcon Icon="@mode.Icon" />
                        </MudAvatar>
                        <MudText Typo="Typo.subtitle1">@mode.Title</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@mode.Description</MudText>
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Default"
                                       @onclick="() => Navigate(mode.Route, fl)"
                                       StartIcon="@Icons.Material.Outlined.Palette">
                                Sans fond
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Info"
                                       @onclick="() => Navigate(bgRoute, fl)"
                                       StartIcon="@Icons.Material.Outlined.Wallpaper">
                                Avec fond
                            </MudButton>
                            @if (mode.HasInteractive)
                            {
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Success"
                                           @onclick="() => Navigate(gridRoute, fl)"
                                           StartIcon="@Icons.Material.Outlined.GridView">
                                    Grid
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Warning"
                                           @onclick="() => Navigate(tableRoute, fl)"
                                           StartIcon="@Icons.Material.Outlined.TableChart">
                                    Table
                                </MudButton>
                            }
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>
        }

    </MudGrid>

</MudStack>

@code {
    private record ModeInfo(string Icon, string Title, string Description, string Route, bool HasInteractive, bool NeedsFullReload);

    private void Navigate(string url, bool forceLoad)
    {
        Nav.NavigateTo(url, forceLoad);
    }

    private readonly ModeInfo[] _modes =
    [
        new(Icons.Material.Outlined.Article,
            "Static SSR",
            "Rendu serveur pur, aucun circuit SignalR ni WASM. HTML statique.",
            "/modes/ssr", false, true),
        new(Icons.Material.Outlined.Hub,
            "Interactive Server",
            "Composants interactifs via SignalR. L'exécution reste sur le serveur.",
            "/modes/server", true, false),
        new(Icons.Material.Outlined.Memory,
            "Interactive Auto (WASM)",
            "Démarre en Server, bascule en WASM. Le code s'exécute côté client.",
            "/modes/wasm", true, false),
        new(Icons.Material.Outlined.AutoMode,
            "Interactive Auto",
            "Démarre en Server, bascule en WASM une fois les ressources téléchargées.",
            "/modes/auto", true, false),
    ];
}
