@page "/demo"
@rendermode InteractiveServer

<PageTitle>Composants Demo</PageTitle>

@* ── Header ─────────────────────────────────────────────────────────── *@
<MdsPageHeader Title="Design System — Vitrine">
    <StartContent><div></div></StartContent>
    <EndContent>
        <MudChip T="string" Color="Color.Primary" Size="Size.Small">MudShell</MudChip>
    </EndContent>
</MdsPageHeader>

<MudStack Spacing="6" Class="px-4 pb-6">
    @* ── Section : ChatBar ──────────────────────────────────────────── *@
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6" Class="mds-u-section-title">MdsChatBar</MudText>
        <MudStack Spacing="1" AlignItems="AlignItems.Center">
            <MdsChatBar Placeholder="@("Message Copilot ou @ mentionnez un onglet")"
                        @bind-Value="_chatValue">
                <Actions>
                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Inherit" />
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" Size="Size.Small"
                               EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                               Class="text-none">Smart</MudButton>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Filled.GraphicEq" Size="Size.Small" Color="Color.Inherit" />
                </Actions>
            </MdsChatBar>
            @if (!string.IsNullOrEmpty(_chatValue))
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">Valeur : @_chatValue</MudText>
            }
        </MudStack>
    </MudStack>

    @* ── Section : FilterTabBar ─────────────────────────────────────── *@
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6" Class="mds-u-section-title">MdsFilterTabBar</MudText>
        <MdsFilterTabBar T="string" @bind-Value="_selectedTab" Items="@_tabs" />
        <MudText Typo="Typo.caption" Color="Color.Secondary">Onglet actif : @_selectedTab</MudText>
    </MudStack>

    @* ── Section : DocumentCard ─────────────────────────────────────── *@
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6" Class="mds-u-section-title">MdsDocumentCard</MudText>
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MdsDocumentCard Icon="@Icons.Material.Outlined.Description"
                                 TypeLabel="Page"
                                 Title="Things to do in Tokyo"
                                 Description="Tokyo offers a vibrant mix of traditional culture and modern attractions." />
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MdsDocumentCard Icon="@Icons.Material.Outlined.Image"
                                 TypeLabel="Image"
                                 Title="Aperçu du projet"
                                 Description="Maquette haute fidélité pour la page d'accueil de l'application." />
            </MudItem>
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MdsDocumentCard Icon="@Icons.Material.Outlined.BarChart"
                                 TypeLabel="Rapport"
                                 Title="Rapport Q3 2024"
                                 Description="Analyse des métriques d'engagement utilisateur sur le trimestre." />
            </MudItem>
        </MudGrid>
    </MudStack>

    @* ── Section : PageHeader variants ─────────────────────────────── *@
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6" Class="mds-u-section-title">MdsPageHeader</MudText>
        <MudPaper Outlined="true" Class="mds-u-surface-wrap">
            <MudStack Spacing="0">
            <MdsPageHeader Title="Titre de page simple" />
            <MdsPageHeader Title="Avec action">
                <StartContent><div></div></StartContent>
                <EndContent>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               Class="text-none">Action</MudButton>
                </EndContent>
            </MdsPageHeader>
            </MudStack>
        </MudPaper>
    </MudStack>

    @* ── Section : BottomNav preview ────────────────────────────────── *@
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6" Class="mds-u-section-title">MdsBottomNav <MudChip T="string" Size="Size.Small">xs / sm</MudChip></MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Visible uniquement sur mobile (≤ 959 px). Aperçu forcé ci-dessous.
        </MudText>
        <MudContainer MaxWidth="MaxWidth.Small" Class="pa-0 ma-0">
            <MudPaper Outlined="true" Class="mds-u-surface-wrap">
                <MdsBottomNav Items="@_navItems" ActiveHref="/" />
            </MudPaper>
        </MudContainer>
    </MudStack>

    @* ── Section : Responsive note ──────────────────────────────────── *@
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6" Class="mds-u-section-title">Breakpoints</MudText>
        <MudSimpleTable Dense="true" Hover="true">
            <thead>
                <tr>
                    <th>Alias</th><th>Largeur</th><th>Sidebar</th><th>BottomNav</th>
                </tr>
            </thead>
            <tbody>
                <tr><td>xs</td><td>&lt; 600 px</td><td>cachée</td><td>visible</td></tr>
                <tr><td>sm</td><td>600 – 959 px</td><td>cachée</td><td>visible</td></tr>
                <tr><td>md</td><td>960 – 1279 px</td><td>icon-only</td><td>cachée</td></tr>
                <tr><td>lg+</td><td>≥ 1280 px</td><td>icon-only / expanded</td><td>cachée</td></tr>
            </tbody>
        </MudSimpleTable>
    </MudStack>

</MudStack>

@code {
    private string _chatValue = string.Empty;
    private string _selectedTab = "pages";

    private readonly MbxTabItem<string>[] _tabs =
    [
        new("images",   "Images"),
        new("pages",    "Pages"),
        new("rapports", "Rapports de recherche"),
        new("videos",   "Vidéos"),
    ];

    private readonly MbxNavItem[] _navItems =
    [
        new(Icons.Material.Outlined.GridView,    "Accueil",   "/"),
        new(Icons.Material.Outlined.EditNote,    "Éditeur"),
        new(Icons.Material.Outlined.ContentCopy, "Biblio",    "/library"),
        new(Icons.Material.Outlined.CheckBox,    "Tâches"),
    ];
}
