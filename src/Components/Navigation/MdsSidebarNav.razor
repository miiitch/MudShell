@namespace MudShell.Components.Navigation
@using Microsoft.AspNetCore.Components.Routing
@using MudShell.Components.Navigation.Models
@using MudShell.Components.Navigation.State
@inject NavigationManager Nav

@if (IsExpanded)
{
    <MudNavMenu Color="Color.Primary" Rounded="true" Dense="true" Class="@($"mbx-sidebar-nav {Class}")" @attributes="AdditionalAttributes">
        @foreach (var node in Items)
        {
            @if (node.Children.Count > 0)
            {
                var expanded = _expandedIds.Contains(node.Id) || State.ActivePath.Contains(node.Id);
                var visibleChildren = node.Children.Where(c => c.Visible).ToList();
                var topChildren = visibleChildren.Where(c => c.Pin == MbxNavPin.Top).ToList();
                var bottomChildren = visibleChildren.Where(c => c.Pin == MbxNavPin.Bottom).ToList();
                var sortableChildren = OrderSortableChildren(node.Id, visibleChildren.Where(c => c.Pin == MbxNavPin.None).ToList());
                <MudNavGroup data-testid="@MudShell.MbxTestId.NavGroup(node.Id)"
                             Title="@node.Text"
                             Icon="@(node.Icon ?? Icons.Material.Outlined.Circle)"
                             IconColor="Color.Inherit"
                             Expanded="@expanded"
                             ExpandedChanged="@(v => ToggleGroup(node.Id, v))"
                             HideExpandIcon="@node.Disabled"
                             Class="mbx-nav-group">
                    @foreach (var child in topChildren)
                    {
                        @RenderSubMenuItem(child)
                    }
                    @if (sortableChildren.Count > 0)
                    {
                        <MudDropContainer @key="@string.Join('|', sortableChildren.Select(c => c.Id))"
                                          T="MbxNavNode"
                                          Items="sortableChildren"
                                          ItemsSelector="@((_, zone) => zone == node.Id)"
                                          ItemDropped="@(info => HandleItemDropped(node.Id, sortableChildren, info))"
                                          Class="mbx-nav-subitem-dropzone">
                            <ChildContent>
                                <MudDropZone T="MbxNavNode" Identifier="@node.Id" Class="mbx-nav-subitem-dropzone-inner" />
                            </ChildContent>
                            <ItemRenderer>
                                @RenderSubMenuItem(context)
                            </ItemRenderer>
                        </MudDropContainer>
                    }
                    @foreach (var child in bottomChildren)
                    {
                        @RenderSubMenuItem(child)
                    }
                </MudNavGroup>
            }
            else
            {
                <MudNavLink data-testid="@MudShell.MbxTestId.Nav(node.Id)"
                            Href="@node.Href"
                            Icon="@(node.Icon ?? Icons.Material.Outlined.Circle)"
                            IconColor="Color.Inherit"
                            Disabled="@node.Disabled"
                            ActiveClass="mbx-nav-link-active">
                    @node.Text
                </MudNavLink>
            }
        }
    </MudNavMenu>
}
else
{
    <div class="mbx-sidebar-nav-collapsed @Class" @attributes="AdditionalAttributes">
        @foreach (var node in Items)
        {
            var isActive = State.ActivePath.Contains(node.Id);
            var iconLinkClass = $"mbx-sidebar-nav-icon-link{(isActive ? " mbx-sidebar-nav-icon-link-active" : "")}";
            <MudTooltip Text="@node.Text" Placement="Placement.Right">
                @if (!string.IsNullOrWhiteSpace(node.Href) && !node.Disabled)
                {
                    <NavLink data-testid="@MudShell.MbxTestId.Nav(node.Id)"
                             href="@node.Href"
                             Match="@ToNavLinkMatch(node.Match)"
                             class="@iconLinkClass"
                             title="@node.Text">
                        <MudIcon Icon="@(node.Icon ?? Icons.Material.Outlined.Circle)" Size="Size.Small" />
                    </NavLink>
                }
                else
                {
                    <MudIconButton Icon="@(node.Icon ?? Icons.Material.Outlined.Circle)"
                                   Disabled="@node.Disabled"
                                   Color="Color.Inherit"
                                   Size="Size.Small" />
                }
            </MudTooltip>
        }
    </div>
}

@code {
    /// <summary>Undeclared attributes, splatted onto the root element (e.g. <c>data-testid</c>, ARIA attributes).</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter] public MbxNavTree? Tree       { get; set; }
    [Parameter] public bool IsExpanded        { get; set; } = true;
    [Parameter] public string? CurrentUri     { get; set; }
    [Parameter] public string? Class          { get; set; }

    /// <summary>Invoked after a drag-and-drop reorder inside the sortable segment of a sub-menu.</summary>
    [Parameter] public EventCallback<MbxNavSortChangedArgs> OnSortChanged { get; set; }

    private IReadOnlyList<MbxNavNode> Items =>
        Tree?.Roots.Where(n => n.Visible).ToList() ?? [];

    private MbxNavState State =>
        MbxNavStateResolver.Resolve(Tree, CurrentUri ?? Nav.Uri);

    private readonly HashSet<string> _expandedIds = new(StringComparer.Ordinal);

    /// <summary>Last known drag-and-drop order of sortable child ids, per group id — kept so the reorder is
    /// reflected immediately even before the parent re-supplies an updated <see cref="Tree"/>.</summary>
    private readonly Dictionary<string, List<string>> _sortOverrides = new(StringComparer.Ordinal);

    private void ToggleGroup(string id, bool isExpanded)
    {
        if (isExpanded) _expandedIds.Add(id);
        else _expandedIds.Remove(id);
    }

    private List<MbxNavNode> OrderSortableChildren(string groupId, List<MbxNavNode> sortableChildren)
    {
        if (!_sortOverrides.TryGetValue(groupId, out var order))
            return sortableChildren;

        var byId = sortableChildren.ToDictionary(c => c.Id, StringComparer.Ordinal);
        var ordered = new List<MbxNavNode>(sortableChildren.Count);
        foreach (var id in order)
        {
            if (byId.Remove(id, out var node))
                ordered.Add(node);
        }
        ordered.AddRange(byId.Values);
        return ordered;
    }

    private Task HandleItemDropped(string groupId, List<MbxNavNode> sortableChildren, MudItemDropInfo<MbxNavNode> dropInfo)
    {
        if (dropInfo.Item is null)
            return Task.CompletedTask;

        var reordered = new List<MbxNavNode>(sortableChildren);
        reordered.Remove(dropInfo.Item);
        var index = Math.Clamp(dropInfo.IndexInZone, 0, reordered.Count);
        reordered.Insert(index, dropInfo.Item);

        var orderedIds = reordered.Select(c => c.Id).ToList();
        _sortOverrides[groupId] = orderedIds;

        return OnSortChanged.InvokeAsync(new MbxNavSortChangedArgs(groupId, orderedIds));
    }

    private RenderFragment RenderSubMenuItem(MbxNavNode child) => __builder =>
    {
        <div class="mbx-nav-subitem">
            <MudNavLink data-testid="@MudShell.MbxTestId.Nav(child.Id)"
                        Href="@child.Href"
                        Icon="@child.Icon"
                        IconColor="Color.Inherit"
                        Disabled="@child.Disabled"
                        ActiveClass="mbx-nav-link-active">
                @child.Text
            </MudNavLink>
            @if (child.TrailingActions is { Count: > 0 })
            {
                <div class="mbx-nav-subitem-actions">
                    @for (var actionIndex = 0; actionIndex < child.TrailingActions.Count; actionIndex++)
                    {
                        var action = child.TrailingActions[actionIndex];
                        <MudIconButton data-testid="@MudShell.MbxTestId.NavAction(child.Id, actionIndex)"
                                       Icon="@action.Icon"
                                       title="@action.Tooltip"
                                       Size="Size.Small"
                                       Color="Color.Inherit"
                                       OnClick="@(() => action.OnClick.InvokeAsync(child.Id))" />
                    }
                </div>
            }
        </div>
    };

    private static NavLinkMatch ToNavLinkMatch(MbxNavMatchMode matchMode) =>
        matchMode == MbxNavMatchMode.All ? NavLinkMatch.All : NavLinkMatch.Prefix;
}
