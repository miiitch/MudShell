@page "/components/data"
@rendermode InteractiveServer

<PageTitle>Metrics and data — MudShell</PageTitle>
<MudStack Spacing="3" Class="pa-4">
    <ShowcaseHeader FamilyId="data" />
    <MdsMainSection Title="Values and trends">
        <MdsStatStrip>
            <MdsStatTile Label="Resources" Value="128" Delta="+12" DeltaTone="MbxDeltaTone.Positive" />
            <MdsStatTile Label="Needs review" Value="7" Tone="MbxTone.Warning" />
            <MdsStatTile Label="Compliance" Value="84%" />
            <MdsStatTile Label="Simulated refresh" Loading="true" />
        </MdsStatStrip>
        <MdsStatStrip Class="mt-3">
            <MdsStatTile Variant="MbxStatTileVariant.Cell" Label="Team" Value="Platform" />
            <MdsStatTile Variant="MbxStatTileVariant.Cell" Label="Last check" Value="Today" />
        </MdsStatStrip>
    </MdsMainSection>
    <MdsMainSection Title="Distribution and activity">
        <MudSwitch T="bool" @bind-Value="_empty" Label="Show empty data" data-testid="data-empty" />
        <h3 class="mb-2">Compliance</h3>
        <MdsDistributionBar Segments="@(_empty ? [] : _segments)" />
        <h3 class="mt-4 mb-2">Trend</h3>
        <MdsSparkline Values="@(_empty ? [] : _trend)" Width="260" Height="48" />
        <h3 class="mt-4 mb-2">Recent runs</h3>
        <MdsRunStrip Runs="@(_empty ? [] : _runs)" />
    </MdsMainSection>
    <ShowcaseDetails FamilyId="data">
        <p>The application supplies the data: these components do not make network requests.</p>
        <MudLink Href="/examples/workspace/detail">See these metrics on a detail page</MudLink>
    </ShowcaseDetails>
</MudStack>

@code {
    private bool _empty;
    private readonly List<MbxDistributionSegment> _segments = [new("Compliant", 41, Tone: MbxTone.Success), new("Needs review", 7, Tone: MbxTone.Warning), new("Not evaluated", 5)];
    private readonly List<double> _trend = [60, 65, 62, 70, 76, 72, 80, 84];
    private readonly List<MbxRun> _runs =
    [
        new(MbxRunOutcome.Success), new(MbxRunOutcome.Failed, "Simulated error: request timed out"),
        new(MbxRunOutcome.Success), new(MbxRunOutcome.Running)
    ];
}
