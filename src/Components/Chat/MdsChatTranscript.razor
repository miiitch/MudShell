@namespace MudShell.Components.Chat
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_root" class="@RootClass" @attributes="AdditionalAttributes">
    <div class="mds-chat-transcript-scroll" role="log" aria-live="polite" aria-relevant="additions" tabindex="0">
        <div class="mds-chat-transcript-content">@ChildContent</div>
    </div>
    <button type="button" class="mds-chat-transcript-jump" aria-label="@JumpLabel" title="@JumpLabel" data-testid="@MbxTestId.ChatJumpToLatest">
        <MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" />
    </button>
</div>

@code {
    private ElementReference _root;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;

    /// <summary>Undeclared attributes, splatted onto the root element (e.g. <c>data-testid</c>, ARIA attributes).</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>The messages (<see cref="MdsChatMessage"/>, <see cref="MdsChatStream"/>, anything).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Follow new content while the reader is at the bottom; stop once they scroll up.</summary>
    [Parameter] public bool AutoScroll { get; set; } = true;

    /// <summary>How close to the bottom (px) still counts as "at the bottom".</summary>
    [Parameter] public int ScrollThreshold { get; set; } = 48;

    [Parameter] public string JumpLabel { get; set; } = "Jump to latest";
    [Parameter] public string? Class { get; set; }

    private string RootClass => $"mds-chat-transcript {Class}".Trim();

    /// <summary>Scrolls to the newest message and resumes following.</summary>
    public async ValueTask ScrollToEndAsync()
    {
        if (_handle is null) { return; }
        try { await _handle.InvokeVoidAsync("scrollToEnd"); } catch (JSDisconnectedException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !AutoScroll) { return; }
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/MudShell/js/mudshell-chat.js");
            _handle = await _module.InvokeAsync<IJSObjectReference>("observeTranscript", _root, ScrollThreshold);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or InvalidOperationException) { }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_handle is not null)
            {
                await _handle.InvokeVoidAsync("dispose");
                await _handle.DisposeAsync();
            }
            if (_module is not null) { await _module.DisposeAsync(); }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException) { }
    }
}
