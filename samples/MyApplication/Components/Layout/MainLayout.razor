@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@using MudShell.Components.Navigation
@using MudShell.Components.Navigation.Models

<MbxAppShell @ref="_shell"
             BackgroundMode="@_bgMode"
             BackgroundImageUrl="@_bgImageUrl"
             IsDarkMode="@_isDarkMode"
             IsDarkModeChanged="@(v => _isDarkMode = v)"
             ContextPanelExpanded="@_contextPanelExpanded"
             ContextPanelExpandedChanged="@(v => _contextPanelExpanded = v)"
             ContextPanelWidth="288"
             ContextPanelCollapsedWidth="72"
             ContextPanelContent="@ContextPanel"
             SidebarExpanded="@_sidebarExpanded"
             SidebarExpandedChanged="@(v => _sidebarExpanded = v)">

    <SidebarContent>
        <NavMenu ShellRef="@_shell" IsExpanded="@_sidebarExpanded" />
    </SidebarContent>

    <ChildContent>
        @Body
    </ChildContent>

    <BottomNavContent>
        <NavMenu ShellRef="@_shell" IsExpanded="false" MobileMode="true" />
    </BottomNavContent>

</MbxAppShell>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private MbxAppShell _shell = default!;
    private MbxAppShell.MbxBackgroundMode _bgMode;
    private string? _bgImageUrl;
    private bool _sidebarExpanded = false;
    private bool _isDarkMode = true;
    private bool _showContextPanel;
    private bool _contextPanelExpanded = true;
    private RenderFragment? ContextPanel => _showContextPanel
        ? @<div>
              <div style="display:flex; justify-content:flex-end; padding:8px 8px 0;">
                  <MudIconButton Icon="@(_contextPanelExpanded ? Icons.Material.Outlined.KeyboardDoubleArrowLeft : Icons.Material.Outlined.KeyboardDoubleArrowRight)"
                                 Size="Size.Small"
                                 Color="Color.Inherit"
                                 title="Réduire/agrandir le panneau contextuel"
                                 OnClick="@(() => _shell.ToggleContextPanel())" />
              </div>
              <MbxContextNavPanel Tree="@_navTree" IsExpanded="@_contextPanelExpanded" />
          </div>
        : null;

    private static readonly MbxNavTree _navTree = new(
    [
        new(
            id: "home",
            text: "Accueil",
            icon: Icons.Material.Outlined.GridView,
            href: "/",
            match: MbxNavMatchMode.All),
        new(
            id: "library",
            text: "Bibliothèque",
            icon: Icons.Material.Outlined.ContentCopy,
            href: "/library",
            match: MbxNavMatchMode.Prefix,
            children:
            [
                new(
                    id: "library.documents",
                    text: "Mes documents",
                    icon: Icons.Material.Outlined.Folder,
                    href: "/library",
                    match: MbxNavMatchMode.Prefix,
                    children:
                    [
                        new(
                            id: "library.documents.folder1",
                            text: "Dossier 1",
                            href: "/library"),
                        new(
                            id: "library.documents.folder2",
                            text: "Dossier 2",
                            href: "/library")
                    ],
                    defaultExpanded: true),
                new(
                    id: "library.history",
                    text: "Historique",
                    icon: Icons.Material.Outlined.History,
                    href: "/library"),
            ])
    ]);

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        ApplyRouteBackground(Nav.Uri);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ApplyRouteBackground(e.Location);
        StateHasChanged();
    }

    private void ApplyRouteBackground(string uri)
    {
        var path = new Uri(uri).AbsolutePath.TrimEnd('/');

        _showContextPanel = path.StartsWith("/library", StringComparison.OrdinalIgnoreCase);

        if (path is "" or "/" || path.EndsWith("/bg", StringComparison.OrdinalIgnoreCase))
        {
            _bgMode    = MbxAppShell.MbxBackgroundMode.Image;
            _bgImageUrl = "/imgs/bg1.jpg";
        }
        else
        {
            _bgMode    = MbxAppShell.MbxBackgroundMode.Palette;
            _bgImageUrl = null;
        }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
