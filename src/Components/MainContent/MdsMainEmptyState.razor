@namespace MudShell.Components.MainContent

<div class="@RootClass">
    <MudStack AlignItems="AlignItems.Center" Spacing="2">
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <MudIcon Icon="@Icon" Size="Size.Large" Class="mbx-main-empty-icon" />
        }

        <MudText Typo="Typo.h6">@Title</MudText>

        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <MudText Typo="Typo.body2" Class="mbx-main-empty-description">
                @Description
            </MudText>
        }

        @if (Action is not null)
        {
            <div class="mt-2">
                @Action
            </div>
        }
    </MudStack>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Aucun élément";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Icon { get; set; } = Icons.Material.Outlined.Inbox;
    [Parameter] public RenderFragment? Action { get; set; }
    [Parameter] public string? Class { get; set; }

    private string RootClass => $"mbx-main-empty-state my-2 {Class}".Trim();
}
