@page "/"
@rendermode InteractiveServer

<PageTitle>MudShell — La vitrine</PageTitle>
<div class="showcase-page" data-testid="showcase-home">
    <div class="showcase-hero">
        <div>
            <MudText Typo="Typo.overline" Color="Color.Primary">La vitrine MudShell</MudText>
            <h1>Des composants.<br />Des interfaces cohérentes.</h1>
            <p>Navigation, espaces de travail, données et conversation : explorez les briques, puis découvrez comment les assembler.</p>
            <MudStack Row Wrap="Wrap.Wrap" Spacing="2">
                <MudButton Href="/components" Variant="Variant.Filled" Color="Color.Primary" data-testid="explore-components">Explorer les composants</MudButton>
                <MudButton Href="/examples" Variant="Variant.Outlined" data-testid="explore-examples">Voir les exemples</MudButton>
            </MudStack>
        </div>
        <MdsMainPart Title="Un espace de travail composé avec MudShell">
            <MdsStatStrip>
                <MdsStatTile Label="Ressources" Value="128" />
                <MdsStatTile Label="Conformité" Value="84 %" />
                <MdsStatTile Label="À examiner" Value="7" />
            </MdsStatStrip>
            <MudButton Href="/examples/workspace/detail" Class="mt-3" EndIcon="@Icons.Material.Outlined.ArrowForward">Ouvrir la fiche exemple</MudButton>
        </MdsMainPart>
    </div>
    <h2 class="mb-4">Explorez les familles de composants</h2>
    <div class="showcase-cards">
        @foreach (var family in ShowcaseCatalog.Families)
        {
            <a class="showcase-card" href="@family.Href" data-testid="@($"home-family-{family.Id}")">
                <MudIcon Icon="@family.Icon" Color="Color.Primary" />
                <h3>@family.Title</h3>
                <p>@family.Description</p>
            </a>
        }
    </div>
    <div class="showcase-callout">
        <div><h2>Les briques prennent tout leur sens ensemble.</h2><p>Des exemples complets, séparés des démonstrations isolées.</p></div>
        <MudButton Href="/examples" Variant="Variant.Outlined">Découvrir les exemples</MudButton>
    </div>
</div>
