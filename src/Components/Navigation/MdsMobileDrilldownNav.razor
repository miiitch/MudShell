@namespace MudShell.Components.Navigation
@using MudShell.Components.Navigation.Models
@using MudShell.Components.BottomNav

@* Kept for compatibility: the mobile level 1 / level 2 / level 3 navigation now lives in MdsBottomNav. *@
<MdsBottomNav Tree="@Tree" CurrentUri="@CurrentUri" @attributes="AdditionalAttributes" />

@code {
    /// <summary>Undeclared attributes, forwarded to <see cref="MdsBottomNav"/>.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter] public MbxNavTree? Tree   { get; set; }
    [Parameter] public string? CurrentUri { get; set; }
}
