@namespace MudShell.Components.Chat
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="@RootClass" style="@_maxWidthStyle" @attributes="AdditionalAttributes">
    <textarea @ref="_textarea"
              class="mds-chat-composer-input"
              rows="1"
              placeholder="@Placeholder"
              value="@Value"
              maxlength="@MaxLength"
              disabled="@Disabled"
              readonly="@ReadOnly"
              aria-label="@(AriaLabel ?? Placeholder)"
              data-send-on-enter="@(SendOnEnter ? "true" : "false")"
              data-testid="@MbxTestId.ChatInput"
              @oninput="HandleInput"></textarea>
    <div class="mds-chat-composer-actions">
        @Actions
        <span class="mds-chat-composer-spacer"></span>
        @if (ShowCounter && MaxLength is > 0)
        {
            <span class="@CounterClass" aria-live="polite" data-testid="@MbxTestId.ChatCounter">@(Value?.Length ?? 0) / @MaxLength</span>
        }
        @EndActions
        @if (IsBusy)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Stop"
                           Size="Size.Small"
                           Color="Color.Primary"
                           Variant="Variant.Filled"
                           Disabled="@Disabled"
                           aria-label="@StopLabel"
                           title="@StopLabel"
                           data-testid="@MbxTestId.ChatStop"
                           OnClick="HandleStop" />
        }
        else
        {
            <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                           Size="Size.Small"
                           Color="Color.Primary"
                           Variant="Variant.Filled"
                           Disabled="@(Disabled || ReadOnly || !CanSend)"
                           aria-label="@SendLabel"
                           title="@SendLabel"
                           data-testid="@MbxTestId.ChatSend"
                           OnClick="SubmitAsync" />
        }
    </div>
</div>

@code {
    private ElementReference _textarea;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;
    private DotNetObjectReference<MdsChatComposer>? _self;

    /// <summary>Undeclared attributes, splatted onto the root element (e.g. <c>data-testid</c>, ARIA attributes).</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter] public string? Placeholder { get; set; } = "Message…";
    [Parameter] public string? Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Raised with the trimmed text when the user sends (Send button or Enter).</summary>
    [Parameter] public EventCallback<string> OnSend { get; set; }

    /// <summary>Raised when the user clicks Stop while <see cref="IsBusy"/> is true.</summary>
    [Parameter] public EventCallback OnStop { get; set; }

    /// <summary>A response is in flight: Send becomes Stop and sending is blocked.</summary>
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>When true, Enter sends and Shift+Enter inserts a newline. When false, Enter inserts a newline and Ctrl/Cmd+Enter sends.</summary>
    [Parameter] public bool SendOnEnter { get; set; } = true;

    /// <summary>Clear the text after <see cref="OnSend"/> completes.</summary>
    [Parameter] public bool ClearOnSend { get; set; } = true;

    /// <summary>Maximum number of characters. Null for unlimited.</summary>
    [Parameter] public int? MaxLength { get; set; }
    [Parameter] public bool ShowCounter { get; set; } = true;

    /// <summary>Maximum height in rows-equivalent (em) before the textarea scrolls.</summary>
    [Parameter] public int MaxRows { get; set; } = 8;

    /// <summary>Actions at the start of the action row (e.g. "+" menu, mode selector).</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>Actions just before the Send/Stop button (e.g. mic).</summary>
    [Parameter] public RenderFragment? EndActions { get; set; }

    [Parameter] public string SendLabel { get; set; } = "Send";
    [Parameter] public string StopLabel { get; set; } = "Stop";
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>CSS max-width value. Defaults to 680px. Use "100%" for full-width.</summary>
    [Parameter] public string MaxWidth { get; set; } = "680px";
    [Parameter] public string? Class { get; set; }

    private bool CanSend => !string.IsNullOrWhiteSpace(Value);
    private string _maxWidthStyle => $"max-width: {MaxWidth}; --mds-chat-composer-max-rows: {MaxRows};";
    private string RootClass => $"mds-chat-composer {(IsBusy ? "mds-chat-composer--busy" : "")} {Class}".Trim();
    private string CounterClass => MaxLength is > 0 && (Value?.Length ?? 0) >= MaxLength * 0.9
        ? "mds-chat-composer-counter mds-chat-composer-counter--warn"
        : "mds-chat-composer-counter";

    /// <summary>Moves keyboard focus to the textarea.</summary>
    public async ValueTask FocusAsync()
    {
        if (_handle is null) { return; }
        try { await _handle.InvokeVoidAsync("focus"); } catch (JSDisconnectedException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                _self = DotNetObjectReference.Create(this);
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/MudShell/js/mudshell-chat.js");
                _handle = await _module.InvokeAsync<IJSObjectReference>("initComposer", _textarea, _self);
            }
            else if (_handle is not null)
            {
                await _handle.InvokeVoidAsync("resize");
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or InvalidOperationException)
        {
            // Circuit gone or prerendering: the composer still works as a plain textarea with the Send button.
        }
    }

    private async Task HandleInput(ChangeEventArgs e)
    {
        if (Disabled || ReadOnly) { return; }
        Value = e.Value?.ToString() ?? string.Empty;
        await ValueChanged.InvokeAsync(Value);
    }

    /// <summary>Called from the browser when Enter (or Ctrl/Cmd+Enter) is pressed; <paramref name="text"/> is the live textarea value.</summary>
    [JSInvokable]
    public async Task HandleEnter(string text)
    {
        Value = text;
        await SubmitAsync();
        StateHasChanged();
    }

    private async Task SubmitAsync()
    {
        if (Disabled || ReadOnly || IsBusy) { return; }
        var text = Value?.Trim();
        if (string.IsNullOrEmpty(text)) { return; }

        await OnSend.InvokeAsync(text);
        if (ClearOnSend)
        {
            Value = string.Empty;
            await ValueChanged.InvokeAsync(Value);
        }
    }

    private Task HandleStop() => OnStop.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_handle is not null)
            {
                await _handle.InvokeVoidAsync("dispose");
                await _handle.DisposeAsync();
            }
            if (_module is not null) { await _module.DisposeAsync(); }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException) { }
        _self?.Dispose();
    }
}
