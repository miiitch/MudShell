@page "/technical"
@rendermode InteractiveServer

<PageTitle>Technical — MudShell</PageTitle>
<MudStack Spacing="3" Class="pa-4">
    <MdsPageHeader Title="Integration and compatibility" />
    <p>Technical details stay accessible without getting mixed into the visual catalogue.</p>
    <MdsMainSection Title="Install and integrate" Description="Register services, imports and MudBlazor providers once at the root.">
        <MdsMainButton Href="https://github.com/miiitch/MudShell/blob/main/src/docs/getting-started.md">Integration guide</MdsMainButton>
    </MdsMainSection>
    <MdsMainSection Title="Blazor compatibility" Description="Static SSR, Server and Auto (with WebAssembly loading): dedicated scenarios and interactivity constraints.">
        <MdsMainButton Href="/modes">Explore render modes</MdsMainButton>
    </MdsMainSection>
    <MdsMainSection Title="Appearance and density" Description="Compare densities and select a theme preset through Appearance in the sidebar.">
        <MdsMainButton Href="/density">Compare densities</MdsMainButton>
    </MdsMainSection>
</MudStack>
