@page "/modes/ssr/bg"

<PageTitle>Static SSR — Fond actif</PageTitle>

<MdsPageHeader Title="Static SSR — Fond d'écran">
    <StartContent><div></div></StartContent>
    <EndContent>
        <MudStack Row="true" Spacing="1" Class="mds-u-chip-row">
            <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined">Aucun circuit actif</MudChip>
            <MudChip T="string" Color="Color.Primary" Size="Size.Small">Fond actif 🖼</MudChip>
        </MudStack>
    </EndContent>
</MdsPageHeader>

<MudStack Spacing="4" Class="px-4 pb-6">

    <MudPaper Outlined="true" Class="pa-4">
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Start">
            <MudIcon Icon="@Icons.Material.Outlined.Wallpaper" Size="Size.Small" />
            <MudText Typo="Typo.body2">
                Même page en <strong>Static SSR</strong>, avec le <strong>fond d'écran activé</strong>.
                Le fond est déclenché automatiquement par le layout lorsque la route se termine par <code>/bg</code>.
            </MudText>
        </MudStack>
    </MudPaper>

    <MudStack Spacing="2">
        <MudText Typo="Typo.subtitle1" Class="mds-u-section-title">MdsChatBar (statique)</MudText>
        <MdsChatBar Placeholder="@("Rendu statique — les événements ne fonctionnent pas")" />
    </MudStack>

    <MudStack Spacing="2">
        <MudText Typo="Typo.subtitle1" Class="mds-u-section-title">MdsDocumentCard (statique)</MudText>
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6" md="4">
                <MdsDocumentCard Icon="@Icons.Material.Outlined.Description"
                                 TypeLabel="Page"
                                 Title="Things to do in Tokyo"
                                 Description="Tokyo offers a vibrant mix of traditional culture and modern attractions." />
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MdsDocumentCard Icon="@Icons.Material.Outlined.BarChart"
                                 TypeLabel="Rapport"
                                 Title="Rapport Q3"
                                 Description="Analyse des métriques d'engagement sur le trimestre." />
            </MudItem>
        </MudGrid>
    </MudStack>

    <MudStack Spacing="2">
        <MudText Typo="Typo.subtitle1" Class="mds-u-section-title">MdsPageHeader (statique)</MudText>
        <MudPaper Outlined="true" Class="mds-u-surface-wrap">
            <MdsPageHeader Title="Titre de page">
                <StartContent><div></div></StartContent>
                <EndContent>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               disabled>
                        Action (désactivée)
                    </MudButton>
                </EndContent>
            </MdsPageHeader>
        </MudPaper>
    </MudStack>

</MudStack>
