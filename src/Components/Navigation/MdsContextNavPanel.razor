@namespace MudShell.Components.Navigation
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@using MudShell.Components.Navigation.Models
@using MudShell.Components.Navigation.State
@inject NavigationManager Nav

<div class="mbx-context-nav-panel @(IsExpanded ? "mbx-context-nav-panel-expanded" : "mbx-context-nav-panel-collapsed") @Class">
    @if (_state.ContextPanelNodes.Count == 0)
    {
        <div class="mbx-context-nav-empty">Aucune navigation contextuelle</div>
    }
    else if (!IsExpanded)
    {
        @foreach (var node in _state.ContextPanelNodes)
        {
            var icon = !string.IsNullOrWhiteSpace(node.Icon) ? node.Icon : Icons.Material.Outlined.Circle;
            var isActiveL2 = _state.ActivePath.Contains(node.Id);
            <MudTooltip Text="@node.Text" Placement="Placement.Right">
                <button type="button"
                        class="mbx-context-collapsed-btn @(isActiveL2 ? "mbx-context-collapsed-btn-active" : "")"
                        disabled="@node.Disabled"
                        @onclick="() => HandleLevel2Click(node)">
                    <MudIcon Icon="@icon" Size="Size.Small" />
                </button>
            </MudTooltip>
        }
    }
    else
    {
        @foreach (var node in _state.ContextPanelNodes)
        {
            var hasChildren = node.Children.Count > 0;
            var isExpanded = _state.ExpandedNodeIds.Contains(node.Id);
            var isActiveL2 = _state.ActivePath.Contains(node.Id);

            <div class="mbx-context-row @(isActiveL2 ? "mbx-context-row-active" : "")">
                <button type="button"
                        class="mbx-context-node-btn"
                        disabled="@node.Disabled"
                        @onclick="() => HandleLevel2Click(node)">
                    <span class="mbx-context-node-main d-inline-flex align-center gap-2">
                        @if (!string.IsNullOrWhiteSpace(node.Icon))
                        {
                            <MudIcon Icon="@node.Icon" Size="Size.Small" />
                        }
                        <span>@node.Text</span>
                    </span>
                    @if (hasChildren)
                    {
                        <MudIcon Icon="@(isExpanded ? Icons.Material.Outlined.ExpandLess : Icons.Material.Outlined.ChevronRight)" Size="Size.Small" />
                    }
                </button>

                @if (hasChildren && isExpanded)
                {
                    <div class="mbx-context-subentries">
                        @foreach (var child in node.Children.Where(c => c.Visible))
                        {
                            var isActiveL3 = _state.ActivePath.Contains(child.Id);
                            var childClass = $"mbx-context-subentry {(isActiveL3 ? "mbx-context-subentry-active" : "")}";
                            @if (!string.IsNullOrWhiteSpace(child.Href) && !child.Disabled)
                            {
                                <NavLink href="@child.Href"
                                         Match="@ToNavLinkMatch(child.Match)"
                                         class="@childClass">
                                    @child.Text
                                </NavLink>
                            }
                            else
                            {
                                <button type="button"
                                        class="@childClass"
                                        disabled="@child.Disabled"
                                        @onclick="() => HandleLeafClick(child)">
                                    @child.Text
                                </button>
                            }
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public MbxNavTree? Tree { get; set; }
    [Parameter] public string? CurrentUri { get; set; }
    [Parameter] public bool SingleExpandedLevel2 { get; set; } = true;
    [Parameter] public bool IsExpanded { get; set; } = true;
    [Parameter] public string? Class { get; set; }

    private MbxNavState _state = MbxNavState.Empty;
    private HashSet<string> _expanded = new(StringComparer.Ordinal);

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        RecomputeState();
    }

    protected override void OnParametersSet() => RecomputeState();

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        RecomputeState();
        InvokeAsync(StateHasChanged);
    }

    private void RecomputeState()
    {
        _state = MbxNavStateResolver.Resolve(
            Tree,
            CurrentUri ?? Nav.Uri,
            _expanded,
            singleExpandLevel2: SingleExpandedLevel2);
    }

    private void HandleLevel2Click(MbxNavNode node)
    {
        if (node.Disabled)
            return;

        if (node.Children.Count > 0)
        {
            if (SingleExpandedLevel2)
            {
                _expanded.RemoveWhere(id => _state.ContextPanelNodes.Any(n => n.Id == id && n.Children.Count > 0));
                _expanded.Add(node.Id);
            }
            else if (!_expanded.Add(node.Id))
            {
                _expanded.Remove(node.Id);
            }
        }

        if (!string.IsNullOrWhiteSpace(node.Href))
            Nav.NavigateTo(node.Href);

        RecomputeState();
    }

    private void HandleLeafClick(MbxNavNode node)
    {
        if (node.Disabled)
            return;

        if (!string.IsNullOrWhiteSpace(node.Href))
            Nav.NavigateTo(node.Href);
    }

    private static NavLinkMatch ToNavLinkMatch(MbxNavMatchMode mode) =>
        mode == MbxNavMatchMode.All ? NavLinkMatch.All : NavLinkMatch.Prefix;

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
