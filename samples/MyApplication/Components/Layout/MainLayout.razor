@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject ThemeState ThemeState
@using MudShell.Components.Navigation
@using MudShell.Components.Navigation.Models

<MdsAppShell @ref="_shell"
             BackgroundMode="@ThemeState.BackgroundMode"
             BackgroundImageUrl="@ThemeState.BackgroundImageUrl"
             IsDarkMode="@ThemeState.IsDarkMode"
             IsDarkModeChanged="@ThemeState.SetDarkMode"
             Density="@ThemeState.Density"
             ContextPanelExpanded="@_contextPanelExpanded"
             ContextPanelExpandedChanged="@(v => _contextPanelExpanded = v)"
             ContextPanelWidth="288"
             ContextPanelCollapsedWidth="72"
             ContextPanelContent="@ContextPanel"
             SidebarExpanded="@_sidebarExpanded"
             SidebarExpandedChanged="@(v => _sidebarExpanded = v)">

    <SidebarContent>
        <NavMenu ShellRef="@_shell" IsExpanded="@_sidebarExpanded" />
    </SidebarContent>

    <ChildContent>
        @Body
    </ChildContent>

</MdsAppShell>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private MdsAppShell _shell = default!;
    private bool _sidebarExpanded = false;
    private bool _showContextPanel;
    private bool _contextPanelExpanded = true;
    private RenderFragment? ContextPanel => _showContextPanel
        ? @<div>
              <div style="display:flex; justify-content:flex-end; align-items:center; height:40px; padding:0 8px;">
                  <MudIconButton Icon="@(_contextPanelExpanded ? Icons.Material.Outlined.KeyboardDoubleArrowLeft : Icons.Material.Outlined.KeyboardDoubleArrowRight)"
                                 Size="Size.Small"
                                 Color="Color.Inherit"
                                 Style="margin:0;"
                                 title="Collapse/expand context panel"
                                 OnClick="@(() => _shell.ToggleContextPanel())" />
              </div>
              <MdsContextNavPanel Tree="@_navTree" IsExpanded="@_contextPanelExpanded" OnSortChanged="@HandleContextSortDemoSortChanged" />
              @if (_contextPanelExpanded)
              {
                  <MudSimpleTable Dense="true" Hover="true" Class="pa-2" data-testid="context-nav-sort-demo-log">
                      <thead>
                          <tr><th>Event</th></tr>
                      </thead>
                      <tbody>
                          @foreach (var entry in _contextSortDemoLog)
                          {
                              <tr><td>@entry</td></tr>
                          }
                      </tbody>
                  </MudSimpleTable>
              }
          </div>
        : null;

    // ── MdsContextNavPanel sub-menu pinning & sorting demo ─────────────
    private readonly List<string> _contextSortDemoLog = [];
    private List<string> _contextSortDemoOrder = ["context-item-alpha", "context-item-beta", "context-item-gamma"];
    private readonly HashSet<string> _contextSortDemoRemoved = [];

    private List<MbxNavNode> BuildContextSortDemoChildren()
    {
        var children = new List<MbxNavNode>
        {
            new(id: "context-item-pinned-top", text: "Pinned to top", pin: MbxNavPin.Top),
        };

        foreach (var id in _contextSortDemoOrder)
        {
            if (_contextSortDemoRemoved.Contains(id))
                continue;

            children.Add(new(
                id: id,
                text: id,
                pin: MbxNavPin.None,
                trailingActions:
                [
                    new MbxNavAction(
                        Icons.Material.Outlined.PushPin,
                        "Remove from list",
                        EventCallback.Factory.Create<string>(this, HandleContextSortDemoRemove))
                ]));
        }

        children.Add(new(id: "context-item-pinned-bottom", text: "Pinned to bottom", pin: MbxNavPin.Bottom));
        return children;
    }

    private void HandleContextSortDemoSortChanged(MbxNavSortChangedArgs args)
    {
        // OnSortChanged fires for every sortable group in the context panel, not just this demo's
        // (e.g. dragging one of the unrelated "Library" children, which default to MbxNavPin.None
        // same as these do) — ignore anything that isn't this group's own reorder.
        if (args.GroupId != "context-sort-demo")
            return;

        _contextSortDemoOrder = args.OrderedIds.ToList();
        _contextSortDemoLog.Insert(0, $"OnSortChanged → [{string.Join(", ", args.OrderedIds)}]");
        StateHasChanged();
    }

    private void HandleContextSortDemoRemove(string id)
    {
        _contextSortDemoRemoved.Add(id);
        _contextSortDemoLog.Insert(0, $"Removed: {id}");
        StateHasChanged();
    }

    private MbxNavTree _navTree => new(
    [
        new(
            id: "home",
            text: "Home",
            icon: Icons.Material.Outlined.GridView,
            href: "/",
            match: MbxNavMatchMode.All),
        new(
            id: "library",
            text: "Library",
            icon: Icons.Material.Outlined.ContentCopy,
            href: "/library",
            match: MbxNavMatchMode.Prefix,
            children:
            [
                new(
                    id: "library.documents",
                    text: "My documents",
                    icon: Icons.Material.Outlined.Folder,
                    href: "/library",
                    match: MbxNavMatchMode.Prefix,
                    children:
                    [
                        new(
                            id: "library.documents.folder1",
                            text: "Folder 1",
                            href: "/library"),
                        new(
                            id: "library.documents.folder2",
                            text: "Folder 2",
                            href: "/library")
                    ],
                    defaultExpanded: true),
                new(
                    id: "library.history",
                    text: "History",
                    icon: Icons.Material.Outlined.History,
                    href: "/library"),
            ]),
        new(
            id: "demo",
            text: "Demo",
            icon: Icons.Material.Outlined.Palette,
            href: "/demo",
            match: MbxNavMatchMode.Prefix,
            children:
            [
                new(
                    id: "demo.showcase",
                    text: "Showcase",
                    icon: Icons.Material.Outlined.Palette,
                    href: "/demo"),
                new(
                    id: "demo.render-modes",
                    text: "Render Modes",
                    icon: Icons.Material.Outlined.DeveloperMode,
                    href: "/modes"),
                new(
                    id: "demo.ssr",
                    text: "Static SSR",
                    icon: Icons.Material.Outlined.Article,
                    href: "/modes/ssr"),
                new(
                    id: "demo.server",
                    text: "Interactive Server",
                    icon: Icons.Material.Outlined.Hub,
                    href: "/modes/server"),
                new(
                    id: "context-sort-demo",
                    text: "Context Sort Demo",
                    icon: Icons.Material.Outlined.Folder,
                    defaultExpanded: true,
                    children: BuildContextSortDemoChildren())
            ],
            defaultExpanded: true),
        new(
            id: "components",
            text: "Components",
            icon: Icons.Material.Outlined.Widgets,
            href: "/components",
            match: MbxNavMatchMode.Prefix,
            children:
            [
                new(
                    id: "components.index",
                    text: "Components Home",
                    icon: Icons.Material.Outlined.GridView,
                    href: "/components"),
                new(
                    id: "components.main",
                    text: "Main Components",
                    icon: Icons.Material.Outlined.ViewAgenda,
                    href: "/main-components"),
                new(
                    id: "components.main-bg",
                    text: "Main Components BG",
                    icon: Icons.Material.Outlined.Wallpaper,
                    href: "/main-components/bg")
            ],
            defaultExpanded: true)
    ]);

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        ThemeState.Changed += OnThemeChanged;
        ApplyRouteLayout(Nav.Uri);
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ApplyRouteLayout(e.Location);
        StateHasChanged();
    }

    private void ApplyRouteLayout(string uri)
    {
        var path = new Uri(uri).AbsolutePath.TrimEnd('/');

        _showContextPanel =
            path.StartsWith("/library", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("/components", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("/main-components", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("/demo", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("/modes", StringComparison.OrdinalIgnoreCase);

        var isBgRoute = path.EndsWith("/bg", StringComparison.OrdinalIgnoreCase);
        ThemeState.SetBackgroundMode(isBgRoute
            ? MdsAppShell.MbxBackgroundMode.Image
            : MdsAppShell.MbxBackgroundMode.Palette);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        ThemeState.Changed -= OnThemeChanged;
    }
}
