@page "/library"
@rendermode InteractiveServer

<PageTitle>Library</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="px-4 pb-4 pt-0">
<MdsPageHeader Title="Library" />

<MdsMainToolbar>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">Create page</MudButton>
</MdsMainToolbar>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="MudBlazor.Wrap.Wrap" Class="mb-3">
    <MudText Typo="Typo.caption" Color="Color.Secondary">Type</MudText>
    @foreach (var tab in _tabs)
    {
        <MudChip T="string"
                 Color="@(_selectedTab == tab.Value ? Color.Primary : Color.Default)"
                 Variant="@(_selectedTab == tab.Value ? Variant.Filled : Variant.Outlined)"
                 OnClick="@(() => _selectedTab = tab.Value)">@tab.Label</MudChip>
    }
</MudStack>

@if (_selectedTab == "pages")
{
    <MudGrid Spacing="3">
        @foreach (var doc in _pages)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MdsDocumentCard Icon="@Icons.Material.Outlined.Description"
                                 TypeLabel="Page"
                                 Title="@doc.Title"
                                 Description="@doc.Description" />
            </MudItem>
        }
    </MudGrid>
}

<MudStack AlignItems="AlignItems.Center" Class="px-4 py-8">
    <MudText Typo="Typo.h5" Align="Align.Center">
        Organize your ideas, edit<br />and share your documents
    </MudText>
    <MudButton Variant="Variant.Filled" Size="Size.Large">
        Create page
    </MudButton>
</MudStack>
</MudContainer>

@code {
    private string _selectedTab = "pages";

    private readonly MbxTabItem<string>[] _tabs =
    [
        new("images",   "Images"),
        new("pages",    "Pages"),
        new("reports", "Research reports"),
    ];

    private readonly List<PageItem> _pages =
    [
        new("Things to do in Tokyo",
            "Tokyo offers a vibrant mix of traditional culture and modern attractions. Here are some highlights to consider during your..."),
        new("Cover Letter Draft",
            "Dear [Hiring Manager], I am writing to express my interest in the [Position]. [Company Name]..."),
        new("History Class Essay",
            "The Industrial Revolution, which began in the late 18th century and continued into the mid-19th century, fundamentally..."),
        new("Poem Draft",
            "In morning light, the city wakes, With fog that dances, swirls and breaks. Cobalt skies emerge above...")
    ];

    private record PageItem(string Title, string Description);
}
