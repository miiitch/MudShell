@page "/components"
@rendermode InteractiveServer

<PageTitle>Components</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Gutters="false" Class="mbx-stack">

    <MdsPageHeader Title="Components">
        <EndContent>
            <MudChip T="string" Color="Color.Default" Size="Size.Small">Subsection</MudChip>
        </EndContent>
    </MdsPageHeader>

    <MdsMainPart Title="Component pages">
        <ChildContent>
            <MudGrid Spacing="2">
                <MudItem xs="12" md="4">
                    <MudPaper Outlined="true" Class="pa-3">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.subtitle1">Chat</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Landing, composer, transcript and streaming.</MudText>
                            <MudStack Row="true" Spacing="1">
                                <MudButton Variant="Variant.Outlined" Href="/chat" StartIcon="@Icons.Material.Outlined.ArrowForward" data-testid="open-chat-demo">Open</MudButton>
                                <MudButton Variant="Variant.Text" Href="/chat-floating">Floating</MudButton>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudPaper Outlined="true" Class="pa-3">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.subtitle1">Main Components</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Toolbar, sections, part states, and empty states.</MudText>
                            <MudButton Variant="Variant.Outlined" Href="/main-components" StartIcon="@Icons.Material.Outlined.ArrowForward">Open</MudButton>
                        </MudStack>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudPaper Outlined="true" Class="pa-3">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.subtitle1">Main Components (BG)</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Same main components on background-image mode.</MudText>
                            <MudButton Variant="Variant.Outlined" Href="/main-components/bg" StartIcon="@Icons.Material.Outlined.ArrowForward">Open</MudButton>
                        </MudStack>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudPaper Outlined="true" Class="pa-3">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.subtitle1">Library</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Documents, cards, and filter-chip browsing layout.</MudText>
                            <MudButton Variant="Variant.Outlined" Href="/library" StartIcon="@Icons.Material.Outlined.ArrowForward">Open</MudButton>
                        </MudStack>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudPaper Outlined="true" Class="pa-3">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.subtitle1">Responsive navigation</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Rail, overlay and bottom sheet across desktop, tablet and mobile widths.</MudText>
                            <MudButton Variant="Variant.Outlined" Href="/responsive-nav" StartIcon="@Icons.Material.Outlined.ArrowForward" data-testid="open-responsive-nav-demo">Open</MudButton>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </ChildContent>
    </MdsMainPart>

</MudContainer>
