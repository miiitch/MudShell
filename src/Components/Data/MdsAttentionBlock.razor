@namespace MudShell.Components.Data

@if (_visibleItems.Count > 0)
{
    <div class="@RootClass" role="status" @attributes="AdditionalAttributes">
        @foreach (var item in _visibleItems)
        {
            <span class="@($"mds-attention-item mds-attention-{ToneName(item.Tone)}")">
                <MudIcon Icon="@IconFor(item.Tone)" Size="Size.Small" aria-hidden="true" />
                @if (!string.IsNullOrWhiteSpace(item.Href))
                {
                    <a href="@item.Href"><b>@item.Count</b> @item.Label</a>
                }
                else
                {
                    <span><b>@item.Count</b> @item.Label</span>
                }
            </span>
        }
    </div>
}

@code {
    /// <summary>Undeclared attributes, splatted onto the root element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Generic counted items. Items with non-positive counts are omitted.</summary>
    [Parameter] public IEnumerable<MbxAttentionItem>? Items { get; set; }

    [Parameter] public string? Class { get; set; }

    private IReadOnlyList<MbxAttentionItem> _visibleItems = [];

    private string RootClass => string.IsNullOrWhiteSpace(Class)
        ? "mds-attention-block"
        : $"mds-attention-block {Class}";

    protected override void OnParametersSet() =>
        _visibleItems = Items?.Where(item => item.Count > 0).ToArray() ?? [];

    private static string ToneName(MbxTone tone) => tone.ToString().ToLowerInvariant();

    private static string IconFor(MbxTone tone) => tone switch
    {
        MbxTone.Success => Icons.Material.Outlined.CheckCircleOutline,
        MbxTone.Warning => Icons.Material.Outlined.WarningAmber,
        MbxTone.Danger => Icons.Material.Outlined.ErrorOutline,
        _ => Icons.Material.Outlined.Info,
    };
}
