@if (MobileMode)
{
    <MbxBottomNav Items="@_allItems" />
}
else
{
    <MbxSidebar IsExpanded="@IsExpanded"
                OnToggle="@(() => ShellRef?.ToggleSidebar())"
                PrimaryItems="@_primaryItems">

        <LogoContent>
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Medium"
                     Style="background: linear-gradient(135deg, #ff6b6b, #ffd93d, #6bcf7f, #4ecdc4, #7e6fff); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-size: 28px; flex-shrink:0;" />
            @if (IsExpanded)
            {
                <span class="nav-app-title">Copilot</span>
            }
        </LogoContent>

        <BottomContent>
            <MudAvatar Size="Size.Small" Style="cursor: pointer; background: var(--mud-palette-gray-light); flex-shrink: 0;">
                <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
            </MudAvatar>
            @if (IsExpanded)
            {
                <div class="nav-profile-info">
                    <span class="nav-profile-name">Michel</span>
                    <span class="nav-profile-sub">Microsoft 365</span>
                </div>
                <MudIconButton Icon="@(ShellRef?.IsDarkMode == true ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                               Size="Size.Small" Color="Color.Inherit"
                               title="@(ShellRef?.IsDarkMode == true ? "Passer en mode clair" : "Passer en mode sombre")"
                               OnClick="@(() => ShellRef?.ToggleDarkMode())"
                               Style="flex-shrink:0; margin-left:auto;" />
            }
        </BottomContent>

    </MbxSidebar>
}

@code {
    [Parameter] public MbxAppShell? ShellRef    { get; set; }
    [Parameter] public bool          IsExpanded  { get; set; }
    [Parameter] public bool          MobileMode  { get; set; } = false;

    private readonly MbxNavItem[] _primaryItems =
    [
        new(Icons.Material.Outlined.GridView,      "Accueil",      "/"),
        new(Icons.Material.Outlined.ContentCopy,   "Bibliothèque", "/library"),
        new(Icons.Material.Outlined.ContentCopy,   "Bibliothèque BG", "/library/bg"),
        new(Icons.Material.Outlined.Palette,       "Demo",         "/demo"),
        new(Icons.Material.Outlined.DeveloperMode, "Render Modes", "/modes"),
    ];

    private MbxNavItem[] _allItems => _primaryItems;
}
