@namespace MudShell.Components.Sidebar
@using Microsoft.AspNetCore.Components.Routing
@using MudShell.Components.Navigation.State
@implements IDisposable
@inject NavigationManager NavigationManager

<div class="mbx-nav @(IsExpanded ? "mbx-nav-expanded" : "")" @attributes="AdditionalAttributes">

    @* Toggle button *@
    <div class="mbx-nav-toggle @(IsExpanded ? "mbx-nav-toggle-expanded" : "")">
        <MudIconButton Icon="@(IsExpanded ? Icons.Material.Outlined.MenuOpen : Icons.Material.Outlined.Menu)"
                       Color="Color.Inherit" Size="Size.Small"
                       Class="mbx-nav-toggle-btn"
                       title="Toggle sidebar"
                       OnClick="HandleToggle" />
    </div>

    @* Logo slot *@
    @if (LogoContent is not null)
    {
        <div class="mbx-nav-logo @(IsExpanded ? "mbx-nav-logo-wide" : "")">
            @LogoContent
        </div>
    }

    @* Primary nav items *@
    @if (PrimaryItems is not null)
    {
        <div class="mbx-nav-items">
            @if (IsExpanded)
            {
                <MudNavMenu Color="Color.Primary" Rounded="true" Dense="true" Class="mbx-sidebar-mud-nav">
                    @foreach (var item in PrimaryItems)
                    {
                        <MudNavLink Href="@item.Href"
                                    Icon="@item.Icon"
                                    IconColor="Color.Inherit"
                                    Match="NavLinkMatch.All"
                                    ActiveClass=""
                                    Class="@(IsActive(item.Href) ? "mbx-nav-link-active" : "")">
                            @item.Label
                        </MudNavLink>
                    }
                </MudNavMenu>
            }
            else
            {
                @foreach (var item in PrimaryItems)
                {
                    <MudTooltip Text="@item.Label" Placement="Placement.Right">
                        @if (item.Href != null)
                        {
                            <NavLink href="@item.Href"
                                     class="@($"mbx-sidebar-icon-link {(IsActive(item.Href) ? "mbx-sidebar-icon-link-active" : "")}")"
                                     Match="NavLinkMatch.All"
                                     ActiveClass="">
                                <MudIcon Icon="@item.Icon" Size="Size.Small" />
                            </NavLink>
                        }
                        else
                        {
                            <MudIconButton Icon="@item.Icon" Color="Color.Inherit" Size="Size.Small" />
                        }
                    </MudTooltip>
                }
            }
        </div>

        <MudDivider Class="@($"mbx-nav-divider {(IsExpanded ? "mbx-nav-divider-wide" : "")}")" />
    }

    @* Secondary nav items *@
    @if (SecondaryItems is not null)
    {
        <div class="mbx-nav-items">
            @if (IsExpanded)
            {
                <MudNavMenu Color="Color.Primary" Rounded="true" Dense="true" Class="mbx-sidebar-mud-nav">
                    @foreach (var item in SecondaryItems)
                    {
                        <MudNavLink Href="@item.Href"
                                    Icon="@item.Icon"
                                    IconColor="Color.Inherit"
                                    Match="NavLinkMatch.All"
                                    ActiveClass=""
                                    Class="@(IsActive(item.Href) ? "mbx-nav-link-active" : "")">
                            @item.Label
                        </MudNavLink>
                    }
                </MudNavMenu>
            }
            else
            {
                @foreach (var item in SecondaryItems)
                {
                    <MudTooltip Text="@item.Label" Placement="Placement.Right">
                        @if (item.Href != null)
                        {
                            <NavLink href="@item.Href"
                                     class="@($"mbx-sidebar-icon-link {(IsActive(item.Href) ? "mbx-sidebar-icon-link-active" : "")}")"
                                     Match="NavLinkMatch.All"
                                     ActiveClass="">
                                <MudIcon Icon="@item.Icon" Size="Size.Small" />
                            </NavLink>
                        }
                        else
                        {
                            <MudIconButton Icon="@item.Icon" Color="Color.Inherit" Size="Size.Small" />
                        }
                    </MudTooltip>
                }
            }
        </div>
    }

    <div class="mbx-nav-spacer"></div>

    @* Bottom slot *@
    @if (BottomContent is not null)
    {
        <div class="mbx-nav-bottom @(IsExpanded ? "mbx-nav-bottom-expanded" : "")">
            @BottomContent
        </div>
    }
</div>

@code {
    /// <summary>Undeclared attributes, splatted onto the root element (e.g. <c>data-testid</c>, ARIA attributes).</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter] public bool                  IsExpanded     { get; set; }
    [Parameter] public EventCallback         OnToggle       { get; set; }
    [Parameter] public MbxNavItem[]?         PrimaryItems   { get; set; }
    [Parameter] public MbxNavItem[]?         SecondaryItems { get; set; }
    [Parameter] public RenderFragment?       LogoContent    { get; set; }
    [Parameter] public RenderFragment?       BottomContent  { get; set; }

    private async Task HandleToggle() => await OnToggle.InvokeAsync();

    private bool IsActive(string? href) => MbxNavStateResolver.IsPrefixMatch(href, NavigationManager.Uri);

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e) => StateHasChanged();

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
