@namespace MyApplication.Client.Components

<MdsFillLayout>
    <Bands>
        <MudChip T="string" Icon="@BadgeIcon" Color="@ModeColor">@RenderModeName</MudChip>
    </Bands>
    <Body>
        <MdsFillRegion>
            <MudTable Items="@_people" Hover="true" Striped="true" Dense="true"
                      FixedHeader="true" Height="100%" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh>Role</MudTh>
                    <MudTh>City</MudTh>
                    <MudTh>Status</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">@context.Name</MudTd>
                    <MudTd DataLabel="Email">@context.Email</MudTd>
                    <MudTd DataLabel="Role">@context.Role</MudTd>
                    <MudTd DataLabel="City">@context.City</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(context.IsActive ? Color.Success : Color.Default)">
                            @(context.IsActive ? "Active" : "Inactive")
                        </MudChip>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MdsFillRegion>
    </Body>
</MdsFillLayout>

@code {
    [Parameter] public string RenderModeName { get; set; } = "Unknown";
    [Parameter] public string BadgeColor     { get; set; } = "default";
    [Parameter] public string BadgeIcon      { get; set; } = Icons.Material.Outlined.Info;
    private Color ModeColor => BadgeColor switch { "server" => Color.Info, "wasm" => Color.Success, "auto" => Color.Warning, _ => Color.Default };

    private record Person(string Name, string Email, string Role, string City, bool IsActive);

    private readonly Person[] _people = GeneratePeople();

    private static Person[] GeneratePeople()
    {
        var firstNames = new[] { "Alice", "Bruno", "Camille", "David", "Emma", "Fabien", "Gabrielle", "Hugo", "Inès", "Julien",
                                  "Karine", "Léo", "Marie", "Nathan", "Olivia", "Paul", "Quentin", "Rose", "Samuel", "Théa",
                                  "Ugo", "Valérie", "William", "Xavier", "Yasmine", "Zoé" };
        var lastNames  = new[] { "Martin", "Bernard", "Dubois", "Thomas", "Robert", "Richard", "Petit", "Durand", "Leroy", "Moreau",
                                  "Simon", "Laurent", "Lefebvre", "Michel", "Garcia", "David", "Bertrand", "Roux", "Vincent", "Fournier" };
        var roles      = new[] { "Developer", "Designer", "Project manager", "Analyst", "DevOps", "Product Owner", "QA", "Data Engineer", "Architect", "Support" };
        var cities     = new[] { "Paris", "Lyon", "Marseille", "Toulouse", "Bordeaux", "Nantes", "Lille", "Strasbourg", "Montpellier", "Rennes" };

        var people = new Person[50];
        for (var i = 0; i < 50; i++)
        {
            var first = firstNames[i % firstNames.Length];
            var last  = lastNames[i % lastNames.Length];
            people[i] = new Person(
                $"{first} {last}",
                $"{first.ToLower()}.{last.ToLower()}@example.com",
                roles[i % roles.Length],
                cities[i % cities.Length],
                i % 5 != 0);
        }
        return people;
    }
}
