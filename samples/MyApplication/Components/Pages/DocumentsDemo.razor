@page "/components/documents"
@rendermode InteractiveServer

<PageTitle>Documents and filters — MudShell</PageTitle>
<MudStack Spacing="3" Class="pa-4">
    <ShowcaseHeader FamilyId="documents" />
    <MdsFilterTabBar T="string" Items="@_tabs" @bind-Value="_filter" />
    <MudGrid>
        @foreach (var doc in _documents.Where(d => _filter == "all" || d.Kind == _filter))
        {
            <MudItem xs="12" md="6" lg="4">
            <MdsDocumentCard Title="@doc.Title" TypeLabel="@doc.Kind" Description="@doc.Description"
                             Icon="@Icons.Material.Outlined.Description" OnClick="@(() => _selected = doc.Title)" />
            </MudItem>
        }
    </MudGrid>
    @if (_selected is not null)
    {
        <MudText role="status" data-testid="document-selection">Selected card: @_selected</MudText>
    }
    @if (_filter == "archived")
    {
        <MdsMainEmptyState Title="No archived documents" Description="Select another category to find documents." />
    }
    <ShowcaseDetails FamilyId="documents">
        <p>The page controls the filter through Value/ValueChanged. Cards are independent of the grid used to arrange them.</p>
        <MudText Typo="Typo.caption">&lt;MdsFilterTabBar T="string" Items="tabs" @("@bind-Value=\"filter\"") /&gt;</MudText>
        <MudLink Href="/examples/library">View the complete library</MudLink>
    </ShowcaseDetails>
</MudStack>

@code {
    private string _filter = "all";
    private string? _selected;
    private readonly MbxTabItem<string>[] _tabs = [new("all", "All"), new("Page", "Pages"), new("Report", "Reports"), new("archived", "Archived")];
    private readonly (string Title, string Kind, string Description)[] _documents =
    [
        ("Project overview", "Page", "Goals and next steps."),
        ("Quarterly report", "Report", "Team metrics and results."),
        ("Meeting notes", "Page", "Decisions and follow-up actions.")
    ];
}
