@namespace MudShell.Components.Navigation
@using Microsoft.AspNetCore.Components.Routing
@using MudShell.Components.Navigation.Models
@using MudShell.Components.Navigation.State
@inject NavigationManager Nav

<div class="mbx-nav mbx-sidebar-nav @(IsExpanded ? "mbx-nav-expanded" : "") @Class">
    @if (Items.Count > 0)
    {
        <div class="mbx-nav-items">
            @foreach (var node in Items)
            {
                @RenderRootNode(node)
            }
        </div>
    }
</div>

@code {
    [Parameter] public MbxNavTree? Tree { get; set; }
    [Parameter] public bool IsExpanded { get; set; } = true;
    [Parameter] public string? CurrentUri { get; set; }
    [Parameter] public string? Class { get; set; }

    private IReadOnlyList<MbxNavNode> Items =>
        Tree?.Roots.Where(n => n.Visible).ToList() ?? [];

    private MbxNavState State =>
        MbxNavStateResolver.Resolve(Tree, CurrentUri ?? Nav.Uri);

    private RenderFragment RenderRootNode(MbxNavNode node) => IsExpanded
        ? @<div class="mbx-nav-item-expanded">
              @if (!string.IsNullOrWhiteSpace(node.Href) && !node.Disabled)
              {
                  <NavLink href="@node.Href"
                           Match="@ToNavLinkMatch(node.Match)"
                           class="mbx-nav-link"
                           ActiveClass="mbx-nav-link-active"
                           title="@node.Text">
                      @RenderNodeContent(node)
                  </NavLink>
              }
              else
              {
                  <div class="mbx-nav-link @(node.Disabled ? "mbx-nav-link-disabled" : "mbx-nav-link-clickable")"
                       title="@node.Text">
                      @RenderNodeContent(node)
                  </div>
              }
          </div>
        : @<MudTooltip Text="@node.Text" Placement="Placement.Right">
              @if (!string.IsNullOrWhiteSpace(node.Href) && !node.Disabled)
              {
                  <NavLink href="@node.Href"
                           Match="@ToNavLinkMatch(node.Match)"
                           class="mbx-sidebar-nav-icon-link"
                           ActiveClass="mbx-sidebar-nav-icon-link-active"
                           title="@node.Text">
                      <MudIcon Icon="@GetIcon(node)" Size="Size.Small" />
                  </NavLink>
              }
              else
              {
                  <MudIconButton Icon="@GetIcon(node)"
                                 Disabled="@node.Disabled"
                                 Color="Color.Inherit"
                                 Size="Size.Small" />
              }
          </MudTooltip>;

    private RenderFragment RenderNodeContent(MbxNavNode node) => @<div class="mbx-sidebar-nav-link-content d-flex align-center mud-width-full gap-3">
        <MudIcon Icon="@GetIcon(node)" Size="Size.Small" Class="mbx-nav-icon" />
        <span class="mbx-nav-label">@node.Text</span>
        @if (node.Badge is not null)
        {
            if (node.Badge.Dot)
            {
                <MudBadge Dot="true" Color="@node.Badge.Color" />
            }
            else if (!string.IsNullOrWhiteSpace(node.Badge.Text))
            {
                <span class="mbx-sidebar-nav-badge ml-auto">
                    @node.Badge.Text
                </span>
            }
        }
    </div>;

    private static string GetIcon(MbxNavNode node) => node.Icon ?? Icons.Material.Outlined.Circle;

    private static NavLinkMatch ToNavLinkMatch(MbxNavMatchMode matchMode) =>
        matchMode == MbxNavMatchMode.All ? NavLinkMatch.All : NavLinkMatch.Prefix;
}
