@namespace MudShell.Components.ChatBar

<div class="@RootClass" style="@_maxWidthStyle" @attributes="AdditionalAttributes">
    <input type="text"
           class="mbx-chat-input"
           placeholder="@Placeholder"
           value="@Value"
           disabled="@Disabled"
           readonly="@ReadOnly"
           @oninput="HandleInput" />
    @if (Actions is not null)
    {
        <div class="d-flex align-center gap-1">
            @Actions
        </div>
    }
</div>

@code {
    /// <summary>Undeclared attributes, splatted onto the root element (e.g. <c>data-testid</c>, ARIA attributes).</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter] public string?           Placeholder   { get; set; } = "Message…";
    [Parameter] public string           Value         { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public RenderFragment?   Actions       { get; set; }
    /// <summary>CSS max-width value. Defaults to 680px. Use "100%" for full-width.</summary>
    [Parameter] public string            MaxWidth      { get; set; } = "680px";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public string? Class { get; set; }

    private string _maxWidthStyle => $"max-width: {MaxWidth};";
    private string RootClass => $"mbx-chat-bar {Class}".Trim();

    private async Task HandleInput(ChangeEventArgs e)
    {
        if (Disabled || ReadOnly)
            return;

        Value = e.Value?.ToString() ?? string.Empty;
        await ValueChanged.InvokeAsync(Value);
    }
}
