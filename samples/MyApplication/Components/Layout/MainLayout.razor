@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject ThemeState ThemeState
@using MudShell.Components.Navigation
@using MudShell.Components.Navigation.Models

<MdsAppShell @ref="_shell"
             BackgroundMode="@ThemeState.BackgroundMode"
             BackgroundImageUrl="@ThemeState.BackgroundImageUrl"
             IsDarkMode="@ThemeState.IsDarkMode"
             IsDarkModeChanged="@ThemeState.SetDarkMode"
             ContextPanelExpanded="@_contextPanelExpanded"
             ContextPanelExpandedChanged="@(v => _contextPanelExpanded = v)"
             ContextPanelWidth="288"
             ContextPanelCollapsedWidth="72"
             ContextPanelContent="@ContextPanel"
             SidebarExpanded="@_sidebarExpanded"
             SidebarExpandedChanged="@(v => _sidebarExpanded = v)">

    <SidebarContent>
        <NavMenu ShellRef="@_shell" IsExpanded="@_sidebarExpanded" />
    </SidebarContent>

    <ChildContent>
        @Body
    </ChildContent>

    <BottomNavContent>
        <NavMenu ShellRef="@_shell" IsExpanded="false" MobileMode="true" />
    </BottomNavContent>

</MdsAppShell>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private MdsAppShell _shell = default!;
    private bool _sidebarExpanded = false;
    private bool _showContextPanel;
    private bool _contextPanelExpanded = true;
    private RenderFragment? ContextPanel => _showContextPanel
        ? @<div>
              <div style="display:flex; justify-content:flex-end; padding:8px 8px 0;">
                  <MudIconButton Icon="@(_contextPanelExpanded ? Icons.Material.Outlined.KeyboardDoubleArrowLeft : Icons.Material.Outlined.KeyboardDoubleArrowRight)"
                                 Size="Size.Small"
                                 Color="Color.Inherit"
                                 title="Réduire/agrandir le panneau contextuel"
                                 OnClick="@(() => _shell.ToggleContextPanel())" />
              </div>
              <MdsContextNavPanel Tree="@_navTree" IsExpanded="@_contextPanelExpanded" />
          </div>
        : null;

    private static readonly MbxNavTree _navTree = new(
    [
        new(
            id: "home",
            text: "Accueil",
            icon: Icons.Material.Outlined.GridView,
            href: "/",
            match: MbxNavMatchMode.All),
        new(
            id: "library",
            text: "Bibliothèque",
            icon: Icons.Material.Outlined.ContentCopy,
            href: "/library",
            match: MbxNavMatchMode.Prefix,
            children:
            [
                new(
                    id: "library.documents",
                    text: "Mes documents",
                    icon: Icons.Material.Outlined.Folder,
                    href: "/library",
                    match: MbxNavMatchMode.Prefix,
                    children:
                    [
                        new(
                            id: "library.documents.folder1",
                            text: "Dossier 1",
                            href: "/library"),
                        new(
                            id: "library.documents.folder2",
                            text: "Dossier 2",
                            href: "/library")
                    ],
                    defaultExpanded: true),
                new(
                    id: "library.history",
                    text: "Historique",
                    icon: Icons.Material.Outlined.History,
                    href: "/library"),
            ])
    ]);

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        ThemeState.Changed += OnThemeChanged;
        ApplyRouteLayout(Nav.Uri);
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ApplyRouteLayout(e.Location);
        StateHasChanged();
    }

    private void ApplyRouteLayout(string uri)
    {
        var path = new Uri(uri).AbsolutePath.TrimEnd('/');

        _showContextPanel = path.StartsWith("/library", StringComparison.OrdinalIgnoreCase);

        var isBgRoute = path.EndsWith("/bg", StringComparison.OrdinalIgnoreCase);
        ThemeState.SetBackgroundMode(isBgRoute
            ? MdsAppShell.MbxBackgroundMode.Image
            : MdsAppShell.MbxBackgroundMode.Palette);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        ThemeState.Changed -= OnThemeChanged;
    }
}
