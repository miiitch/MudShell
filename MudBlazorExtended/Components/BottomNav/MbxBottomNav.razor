@namespace MudBlazorExtended.Components.BottomNav
@using MudBlazorExtended.Components.Sidebar

<div class="mbx-bottom-nav">
    @foreach (var item in Items ?? [])
    {
        var isActive = item.Href == ActiveHref;
        <a href="@(item.Href ?? "#")"
           class="mbx-bottom-nav-item @(isActive ? "mbx-bottom-nav-item-active" : "")">
            <MudIcon Icon="@item.Icon" Size="Size.Small" />
            <span class="mbx-bottom-nav-label">@item.Label</span>
        </a>
    }
</div>

@code {
    [Parameter] public MbxNavItem[]? Items     { get; set; }
    [Parameter] public string?       ActiveHref { get; set; }
}
