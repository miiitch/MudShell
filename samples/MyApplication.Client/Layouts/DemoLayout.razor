@namespace MyApplication.Client.Layouts
@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject ThemeState ThemeState

<MudBreakpointProvider OnBreakpointChanged="@BreakpointChanged">
<div class="showcase-shell">
<MdsAppShell @ref="_shell"
             BackgroundMode="@ThemeState.BackgroundMode"
             BackgroundImageUrl="@ThemeState.BackgroundImageUrl"
             IsDarkMode="@ThemeState.IsDarkMode"
             IsDarkModeChanged="@ThemeState.SetDarkMode"
             Density="@ThemeState.Density"
             ContextPanelExpanded="@_contextExpanded"
             ContextPanelExpandedChanged="@(v => _contextExpanded = v)"
             ContextPanelWidth="288" ContextPanelCollapsedWidth="72"
             ContextPanelContent="@ContextPanel"
             SidebarExpanded="@_expanded"
             SidebarExpandedChanged="@(v => _expanded = v)">
    <SidebarContent>
        <ShowcaseSidebar ShellRef="@_shell" IsExpanded="@_expanded" />
    </SidebarContent>
    <ChildContent>@Body</ChildContent>
</MdsAppShell>
</div>
</MudBreakpointProvider>

<div id="blazor-error-ui" data-nosnippet>
    Une erreur inattendue est survenue.
    <a href="." class="reload">Recharger</a>
</div>

@code {
    private MdsAppShell _shell = default!;
    private bool _expanded;
    private bool _contextExpanded = true;
    private bool _showContext;
    private bool _narrow;
    private RenderFragment? ContextPanel => _showContext
        ? @<ShowcaseContextPanel IsExpanded="@_contextExpanded" OnToggle="@(() => _shell.ToggleContextPanel())" />
        : null;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += LocationChanged;
        ThemeState.Changed += ThemeChanged;
        ApplyRoute();
    }

    private void ThemeChanged() => InvokeAsync(StateHasChanged);
    private void BreakpointChanged(Breakpoint breakpoint)
    {
        var narrow = breakpoint is Breakpoint.Xs or Breakpoint.Sm;
        if (_narrow == narrow) return;
        _narrow = narrow;
        _contextExpanded = !narrow;
    }
    private void LocationChanged(object? sender, LocationChangedEventArgs args)
    {
        ApplyRoute();
        InvokeAsync(StateHasChanged);
    }

    private void ApplyRoute()
    {
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        _showContext = ShowcaseCatalog.HasContext(path) || path == "/demo";
        if (path.EndsWith("/bg", StringComparison.OrdinalIgnoreCase))
            ThemeState.SetBackgroundMode(MdsAppShell.MbxBackgroundMode.Image);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= LocationChanged;
        ThemeState.Changed -= ThemeChanged;
    }
}
