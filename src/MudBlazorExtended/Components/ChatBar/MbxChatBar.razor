@namespace MudBlazorExtended.Components.ChatBar

<div class="mbx-chat-bar" style="@_maxWidthStyle">
    <input type="text"
           class="mbx-chat-input"
           placeholder="@Placeholder"
           value="@Value"
           @oninput="HandleInput" />
    @if (Actions is not null)
    {
        <div class="mbx-chat-actions">
            @Actions
        </div>
    }
</div>

@code {
    [Parameter] public string?           Placeholder   { get; set; } = "Message…";
    [Parameter] public string           Value         { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public RenderFragment?   Actions       { get; set; }
    /// <summary>CSS max-width value. Defaults to 680px. Use "100%" for full-width.</summary>
    [Parameter] public string            MaxWidth      { get; set; } = "680px";

    private string _maxWidthStyle => $"max-width: {MaxWidth};";

    private async Task HandleInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? string.Empty;
        await ValueChanged.InvokeAsync(Value);
    }
}
