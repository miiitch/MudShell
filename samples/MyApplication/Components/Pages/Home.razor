@page "/"
@rendermode InteractiveServer
@inject NavigationManager Nav

<PageTitle>Home</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="pa-4">
<MudStack Spacing="3">
    <MudStack Row="true" Justify="Justify.FlexEnd">
        <MudIconButton Icon="@Icons.Material.Outlined.Tune" Color="Color.Inherit" Size="Size.Small" />
    </MudStack>

    <MudText Typo="Typo.h4">
        C'est un plaisir te revoir, Michel.<br />
        Quelles sont les dernières nouvelles?
    </MudText>

    <MdsChatBar Placeholder="@("Message Copilot ou @ mentionnez un onglet")"
                @bind-Value="_chatMessage">
        <Actions>
            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Inherit" />
            <MudButton Variant="Variant.Text" Color="Color.Inherit" Size="Size.Small"
                       EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                       Class="text-none">Smart</MudButton>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.GraphicEq" Size="Size.Small" Color="Color.Inherit" />
        </Actions>
    </MdsChatBar>

    <MudPaper Outlined="true" Class="pa-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mds-u-inline-title">
            <MudIcon Icon="@Icons.Material.Outlined.Devices" Size="Size.Small" />
            <MudText Typo="Typo.subtitle1">Modes de rendu Blazor</MudText>
        </MudStack>

        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Default"
                       OnClick="@(() => Nav.NavigateTo("/modes/ssr", true))"
                       StartIcon="@Icons.Material.Outlined.Article">
                Static SSR
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Info" Href="/modes/server"
                       StartIcon="@Icons.Material.Outlined.Hub">
                Interactive Server
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Success" Href="/modes/wasm"
                       StartIcon="@Icons.Material.Outlined.Memory">
                Auto (WASM)
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Href="/modes/auto"
                       StartIcon="@Icons.Material.Outlined.AutoMode">
                Interactive Auto
            </MudButton>
        </MudStack>

        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/modes"
                   EndIcon="@Icons.Material.Filled.ArrowForward"
                   Class="mt-1 text-none">
            Voir toutes les combinaisons
        </MudButton>
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mds-u-inline-title">
            <MudIcon Icon="@Icons.Material.Outlined.TableChart" Size="Size.Small" />
            <MudText Typo="Typo.subtitle2">Acces rapide</MudText>
        </MudStack>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/europe-cities"
                   StartIcon="@Icons.Material.Outlined.TravelExplore" Class="text-none">
            Ouvrir le dashboard Villes Europe
        </MudButton>
    </MudPaper>
</MudStack>
 </MudContainer>

@code {
    private string _chatMessage = string.Empty;
}
