@namespace MudShell.Components.Navigation
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@using MudShell.Components.Navigation.Models
@using MudShell.Components.Navigation.State
@inject NavigationManager Nav

<div class="mbx-mobile-drilldown-nav">
    @if (_showPanel && _currentLevelNodes.Count > 0)
    {
        <div class="mbx-mobile-drilldown-panel">
            <div class="mbx-mobile-drilldown-header">
                @if (_stack.Count > 0)
                {
                    <MudIconButton Icon="@Icons.Material.Outlined.ArrowBack" Size="Size.Small" OnClick="GoBack" />
                }
                <span class="mbx-mobile-drilldown-title">@_panelTitle</span>
                <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" OnClick="ClosePanel" />
            </div>
            <div class="mbx-mobile-drilldown-list">
                @foreach (var node in _currentLevelNodes)
                {
                    var hasChildren = node.Children.Any(c => c.Visible);
                    var isActive = _state.ActivePath.Contains(node.Id);
                    <button type="button"
                            class="mbx-mobile-drilldown-item @(isActive ? "mbx-mobile-drilldown-item-active" : "")"
                            disabled="@node.Disabled"
                            @onclick="() => HandlePanelNodeClick(node)">
                        <span class="mbx-mobile-drilldown-item-main">
                            @if (!string.IsNullOrWhiteSpace(node.Icon))
                            {
                                <MudIcon Icon="@node.Icon" Size="Size.Small" />
                            }
                            <span>@node.Text</span>
                        </span>
                        @if (hasChildren)
                        {
                            <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" />
                        }
                    </button>
                }
            </div>
        </div>
    }

    <div class="mbx-bottom-nav">
        @foreach (var root in _roots)
        {
            var isActive = string.Equals(_state.ActiveRootId, root.Id, StringComparison.Ordinal);
            <button type="button"
                    class="mbx-bottom-nav-item @(isActive ? "mbx-bottom-nav-item-active" : "")"
                    @onclick="() => HandleRootClick(root)">
                <MudIcon Icon="@(root.Icon ?? Icons.Material.Outlined.Circle)" Size="Size.Small" />
                <span class="mbx-bottom-nav-label">@root.Text</span>
            </button>
        }
    </div>
</div>

@code {
    [Parameter] public MbxNavTree? Tree { get; set; }
    [Parameter] public string? CurrentUri { get; set; }

    private MbxNavState _state = MbxNavState.Empty;
    private bool _showPanel;
    private string _panelTitle = "";
    private readonly Stack<(string Title, IReadOnlyList<MbxNavNode> Nodes)> _stack = new();
    private IReadOnlyList<MbxNavNode> _currentLevelNodes = [];
    private IReadOnlyList<MbxNavNode> _roots = [];

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        RecomputeState();
    }

    protected override void OnParametersSet() => RecomputeState();

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        RecomputeState();
        InvokeAsync(StateHasChanged);
    }

    private void RecomputeState()
    {
        _roots = Tree?.Roots.Where(r => r.Visible).ToList() ?? [];
        _state = MbxNavStateResolver.Resolve(Tree, CurrentUri ?? Nav.Uri);
    }

    private void HandleRootClick(MbxNavNode root)
    {
        if (root.Disabled)
            return;

        if (!string.IsNullOrWhiteSpace(root.Href))
            Nav.NavigateTo(root.Href);

        var level2 = root.Children.Where(c => c.Visible).ToList();
        if (level2.Count == 0)
        {
            ClosePanel();
            return;
        }

        _stack.Clear();
        _currentLevelNodes = level2;
        _panelTitle = root.Text;
        _showPanel = true;
    }

    private void HandlePanelNodeClick(MbxNavNode node)
    {
        if (node.Disabled)
            return;

        var children = node.Children.Where(c => c.Visible).ToList();

        if (!string.IsNullOrWhiteSpace(node.Href))
            Nav.NavigateTo(node.Href);

        if (children.Count > 0)
        {
            _stack.Push((_panelTitle, _currentLevelNodes));
            _panelTitle = node.Text;
            _currentLevelNodes = children;
            return;
        }

        ClosePanel();
    }

    private void GoBack()
    {
        if (_stack.Count == 0)
        {
            ClosePanel();
            return;
        }

        var previous = _stack.Pop();
        _panelTitle = previous.Title;
        _currentLevelNodes = previous.Nodes;
    }

    private void ClosePanel()
    {
        _showPanel = false;
        _panelTitle = "";
        _currentLevelNodes = [];
        _stack.Clear();
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}

