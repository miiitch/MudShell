@namespace MudShell.Components.MainContent

<MudPaper Elevation="2" Class="@RootClass" Style="@RootStyle">
    <MudStack Row="true"
              AlignItems="AlignItems.Center"
              Spacing="@Spacing"
              Wrap="@(AllowWrap ? MudBlazor.Wrap.Wrap : MudBlazor.Wrap.NoWrap)">
        @ChildContent
    </MudStack>
</MudPaper>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public int Spacing { get; set; } = 2;
    [Parameter] public bool AllowWrap { get; set; } = true;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public MbxAccentBorderSides AccentBorderSides { get; set; } = MbxAccentBorderSides.Left;
    [Parameter] public string AccentBorderColor { get; set; } = "var(--mud-palette-primary)";
    [Parameter] public int AccentBorderWidth { get; set; } = 2;

    private string RootClass => $"pa-3 mb-3 {Class}".Trim();
    private string RootStyle => MergeStyles(
        MbxAccentBorderStyle.Build(AccentBorderSides, AccentBorderColor, AccentBorderWidth),
        Style);

    private static string MergeStyles(string? first, string? second)
    {
        if (string.IsNullOrWhiteSpace(first)) return second ?? string.Empty;
        if (string.IsNullOrWhiteSpace(second)) return first;
        return $"{first.TrimEnd(';')};{second}";
    }
}
