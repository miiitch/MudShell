@page "/"
@rendermode InteractiveServer

<PageTitle>MudShell — Showcase</PageTitle>
<div class="showcase-page" data-testid="showcase-home">
    <div class="showcase-hero">
        <div>
            <MudText Typo="Typo.overline" Color="Color.Primary">The MudShell showcase</MudText>
            <h1>Building blocks.<br />Consistent interfaces.</h1>
            <p>Navigation, workspaces, data and conversation: explore the building blocks, then discover how to combine them.</p>
            <MudStack Row Wrap="Wrap.Wrap" Spacing="2">
                <MudButton Href="/components" Variant="Variant.Filled" Color="Color.Primary" data-testid="explore-components">Explore components</MudButton>
                <MudButton Href="/examples" Variant="Variant.Outlined" data-testid="explore-examples">View examples</MudButton>
            </MudStack>
        </div>
        <MdsMainPart Title="A workspace built with MudShell">
            <MdsStatStrip>
                <MdsStatTile Label="Resources" Value="128" />
                <MdsStatTile Label="Compliance" Value="84%" />
                <MdsStatTile Label="Needs review" Value="7" />
            </MdsStatStrip>
            <MudButton Href="/examples/workspace/detail" Class="mt-3" EndIcon="@Icons.Material.Outlined.ArrowForward">Open the detail example</MudButton>
        </MdsMainPart>
    </div>
    <h2 class="mb-4">Explore component families</h2>
    <div class="showcase-cards">
        @foreach (var family in ShowcaseCatalog.Families)
        {
            <a class="showcase-card" href="@family.Href" data-testid="@($"home-family-{family.Id}")">
                <MudIcon Icon="@family.Icon" Color="Color.Primary" />
                <h3>@family.Title</h3>
                <p>@family.Description</p>
            </a>
        }
    </div>
    <div class="showcase-callout">
        <div><h2>Better together.</h2><p>Complete examples, separate from individual component demos.</p></div>
        <MudButton Href="/examples" Variant="Variant.Outlined">Discover examples</MudButton>
    </div>
</div>
