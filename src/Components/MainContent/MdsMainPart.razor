@namespace MudShell.Components.MainContent

<MudPaper Elevation="2" Class="@RootClass" Style="@RootStyle" @attributes="AdditionalAttributes">
    <MudStack Spacing="2">
        @if (!string.IsNullOrWhiteSpace(Title) || HeaderActions is not null)
        {
            <div class="d-flex align-center justify-space-between gap-3">
                <div class="d-flex align-center gap-2">
                    @if (!string.IsNullOrWhiteSpace(Icon))
                    {
                        <MudIcon Icon="@Icon" Color="@TitleColor" />
                    }
                    @if (!string.IsNullOrWhiteSpace(Title))
                    {
                        <MudText Typo="Typo.h6" Color="@TitleColor">@Title</MudText>
                    }
                </div>
                @if (HeaderActions is not null)
                {
                    <div class="d-flex align-center gap-2">@HeaderActions</div>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@Subtitle</MudText>
            }
        }

        @if (IsLoading)
        {
            <MudStack data-testid="part-loading" AlignItems="AlignItems.Center" Spacing="2" Class="py-6">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                <MudText Color="Color.Secondary">@LoadingText</MudText>
            </MudStack>
        }
        else if (!string.IsNullOrWhiteSpace(Error))
        {
            <MudAlert data-testid="part-error" Severity="Severity.Error" ContentAlignment="HorizontalAlignment.Start">
                @Error
                @if (OnRetry.HasDelegate)
                {
                    <div class="mt-2">
                        <MdsMainButton data-testid="btn-retry" Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="@OnRetry">
                            Retry
                        </MdsMainButton>
                    </div>
                }
            </MudAlert>
        }
        else
        {
            @ChildContent
        }
    </MudStack>
</MudPaper>

@code {
    /// <summary>Undeclared attributes, splatted onto the root element (e.g. <c>data-testid</c>, ARIA attributes).</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public Color TitleColor { get; set; } = Color.Primary;
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string LoadingText { get; set; } = "Loading...";
    [Parameter] public string? Error { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
    [Parameter] public RenderFragment? HeaderActions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public MbxAccentBorderSides AccentBorderSides { get; set; } = MbxAccentBorderSides.Left;
    [Parameter] public string AccentBorderColor { get; set; } = "var(--mud-palette-primary)";
    [Parameter] public int AccentBorderWidth { get; set; } = 2;

    private string RootClass => $"pa-4 mb-3 {Class}".Trim();
    private string RootStyle => MergeStyles(
        MbxAccentBorderStyle.Build(AccentBorderSides, AccentBorderColor, AccentBorderWidth),
        Style);

    private static string MergeStyles(string? first, string? second)
    {
        if (string.IsNullOrWhiteSpace(first)) return second ?? string.Empty;
        if (string.IsNullOrWhiteSpace(second)) return first;
        return $"{first.TrimEnd(';')};{second}";
    }
}
