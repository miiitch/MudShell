@page "/main-components"
@rendermode InteractiveServer

<PageTitle>Main components</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="px-4 pb-4 pt-0">
<MdsPageHeader Title="Main components">
    <StartContent><div></div></StartContent>
    <EndContent>
        <MdsMainButton Variant="Variant.Outlined" Color="Color.Inherit" Href="/main-components/bg" Compact="true">
            View BG version
        </MdsMainButton>
    </EndContent>
</MdsPageHeader>

<MudStack Spacing="4" Class="my-2">
    <MdsMainToolbar>
        <MdsMainButton StartIcon="@Icons.Material.Outlined.Add" OnClick="@(() => _counter++)">New item</MdsMainButton>
        <MdsMainButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Outlined.FilterList">Filter</MdsMainButton>
        <MdsMainStatusBadge Label="Active" Status="active" />
        <MdsMainStatusBadge Label="Pending" Status="pending" />
        <MudSpacer />
        <MudText Typo="Typo.body2" Color="Color.Secondary">Triggered actions: @_counter</MudText>
    </MdsMainToolbar>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="7">
            <MdsMainSection Title="Catalog section"
                            Description="Consistent section wrapper aligned with the MudShell theme."
                            Icon="@Icons.Material.Outlined.ViewAgenda">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.body2"><MudIcon Icon="@Icons.Material.Outlined.Description" Size="Size.Small" Class="mr-2" />Pages</MudText>
                    <MudText Typo="Typo.body2"><MudIcon Icon="@Icons.Material.Outlined.Image" Size="Size.Small" Class="mr-2" />Images</MudText>
                    <MudText Typo="Typo.body2"><MudIcon Icon="@Icons.Material.Outlined.TableChart" Size="Size.Small" Class="mr-2" />Reports</MudText>
                </MudStack>
            </MdsMainSection>
        </MudItem>

        <MudItem xs="12" md="5">
            <MdsMainPart Title="State part"
                         Subtitle="Loading / error / content through a single API"
                         Icon="@Icons.Material.Outlined.DataObject"
                         IsLoading="@_isLoading"
                         Error="@_error"
                         OnRetry="@RetryPart">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.body2">Primary content for this part.</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Last updated: @DateTime.Now.ToString("HH:mm:ss")</MudText>
                </MudStack>
            </MdsMainPart>
            <MudStack Row="true" Spacing="1" Class="mt-2">
                <MdsMainButton Variant="Variant.Text" Color="Color.Inherit" Compact="true" OnClick="@ToggleLoading">Toggle loading</MdsMainButton>
                <MdsMainButton Variant="Variant.Text" Color="Color.Error" Compact="true" OnClick="@ToggleError">Toggle error</MdsMainButton>
            </MudStack>
        </MudItem>
    </MudGrid>

    <MdsMainEmptyState Title="No filtered documents"
                       Description="Adjust your filters or create a new document to populate the main area."
                       Icon="@Icons.Material.Outlined.Inbox">
        <Action>
            <MdsMainButton StartIcon="@Icons.Material.Outlined.CreateNewFolder">Create document</MdsMainButton>
        </Action>
    </MdsMainEmptyState>
</MudStack>
</MudContainer>

@code {
    private int _counter;
    private bool _isLoading;
    private string? _error;

    private void ToggleLoading() => _isLoading = !_isLoading;

    private void ToggleError()
    {
        _error = _error is null ? "Unable to load data right now." : null;
        _isLoading = false;
    }

    private void RetryPart()
    {
        _error = null;
        _isLoading = true;
    }
}
