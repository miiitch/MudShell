@namespace MyApplication.Client.Layouts
@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject ThemeState ThemeState
@inject IDialogService DialogService
@using MudShell.Components.Navigation.Models

<MdsAppShell @ref="_shell"
             BackgroundMode="@ThemeState.BackgroundMode"
             BackgroundImageUrl="@ThemeState.BackgroundImageUrl"
             IsDarkMode="@ThemeState.IsDarkMode"
             IsDarkModeChanged="@ThemeState.SetDarkMode"
             ContextPanelExpanded="@_contextPanelExpanded"
             ContextPanelExpandedChanged="@(v => _contextPanelExpanded = v)"
             ContextPanelWidth="288"
             ContextPanelCollapsedWidth="72"
             ContextPanelContent="@ContextPanel"
             SidebarExpanded="@_expanded"
             SidebarExpandedChanged="@(v => _expanded = v)">

    <SidebarContent>
        <MdsSidebar IsExpanded="@_expanded"
                    OnToggle="@HandleToggle"
                    PrimaryItems="@_navItems">
            <LogoContent>
                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Medium"
                         Style="background: linear-gradient(135deg, #ff6b6b, #ffd93d, #6bcf7f, #4ecdc4, #7e6fff); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-size: 28px; flex-shrink:0;" />
                @if (_expanded)
                {
                    <span style="font-size:17px; font-weight:600; white-space:nowrap;">Copilot</span>
                }
            </LogoContent>
            <BottomContent>
                <MudIconButton Icon="@Icons.Material.Outlined.ColorLens"
                               Size="Size.Small" Color="Color.Inherit"
                               title="Thème et fond"
                               OnClick="@OpenThemeDialog" />
                @if (_expanded)
                {
                    <span style="font-size:13px; color:var(--mud-palette-text-secondary);">
                        Thème et fond
                    </span>
                }
            </BottomContent>
        </MdsSidebar>
    </SidebarContent>

    <ChildContent>@Body</ChildContent>

</MdsAppShell>

@code {
    private MdsAppShell _shell = default!;
    private bool _expanded;
    private bool _showContextPanel;
    private bool _contextPanelExpanded = true;
    private RenderFragment? ContextPanel => _showContextPanel
        ? @<div>
              <div style="display:flex; justify-content:flex-end; align-items:center; height:40px; padding:0 8px;">
                  <MudIconButton Icon="@(_contextPanelExpanded ? Icons.Material.Outlined.KeyboardDoubleArrowLeft : Icons.Material.Outlined.KeyboardDoubleArrowRight)"
                                 Size="Size.Small"
                                 Color="Color.Inherit"
                                 Style="margin:0;"
                                 title="Réduire/agrandir le panneau contextuel"
                                 OnClick="@(() => _shell.ToggleContextPanel())" />
              </div>
              <MdsContextNavPanel Tree="@_libraryContextTree" IsExpanded="@_contextPanelExpanded" />
          </div>
        : null;

    private static readonly MbxNavTree _libraryContextTree = new(
    [
        new(
            id: "library",
            text: "Bibliothèque",
            icon: Icons.Material.Outlined.ContentCopy,
            href: "/library/bg",
            match: MbxNavMatchMode.Prefix,
            children:
            [
                new(
                    id: "library.documents",
                    text: "Mes documents",
                    icon: Icons.Material.Outlined.Folder,
                    href: "/library/bg",
                    match: MbxNavMatchMode.Prefix,
                    children:
                    [
                        new(
                            id: "library.documents.folder1",
                            text: "Dossier 1",
                            href: "/library/bg"),
                        new(
                            id: "library.documents.folder2",
                            text: "Dossier 2",
                            href: "/library/bg")
                    ],
                    defaultExpanded: true),
                new(
                    id: "library.history",
                    text: "Historique",
                    icon: Icons.Material.Outlined.History,
                    href: "/library/bg")
            ])
    ]);

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        ThemeState.Changed += OnThemeChanged;
        ApplyRouteLayout(Nav.Uri);
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ApplyRouteLayout(e.Location);
        StateHasChanged();
    }

    private void ApplyRouteLayout(string uri)
    {
        var path = new Uri(uri).AbsolutePath.TrimEnd('/');
        _showContextPanel = path.StartsWith("/library", StringComparison.OrdinalIgnoreCase);

        var isBgRoute = path.EndsWith("/bg", StringComparison.OrdinalIgnoreCase);
        ThemeState.SetBackgroundMode(isBgRoute
            ? MdsAppShell.MbxBackgroundMode.Image
            : MdsAppShell.MbxBackgroundMode.Palette);
    }

    private void HandleToggle() => _shell.ToggleSidebar();

    private async Task OpenThemeDialog()
    {
        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        await DialogService.ShowAsync<ThemeOptionsPanel>("Thème et fond", options);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        ThemeState.Changed -= OnThemeChanged;
    }

    private readonly MbxNavItem[] _navItems =
    [
        new(Icons.Material.Outlined.GridView,      "Accueil",         "/"),
        new(Icons.Material.Outlined.ContentCopy,   "Bibliothèque",    "/library"),
        new(Icons.Material.Outlined.Widgets,       "Composants",      "/main-components"),
        new(Icons.Material.Outlined.Palette,       "Demo",            "/demo"),
        new(Icons.Material.Outlined.DeveloperMode, "Render Modes",    "/modes"),
    ];
}
