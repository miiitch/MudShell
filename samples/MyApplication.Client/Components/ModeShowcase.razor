@namespace MyApplication.Client.Components

<MudStack Spacing="4" Class="pa-4">
    @* Render mode badge *@
    <MudChip T="string" Icon="@BadgeIcon" Color="@ModeColor">@RenderModeName</MudChip>

    @* Interactivity proof — counter *@
    <MdsMainSection Title="Interactivity check">
        <MudStack Row AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="@(() => _count++)">
                Click
            </MudButton>
            <MudText>Clicks: <strong>@_count</strong></MudText>
            @if (_count > 0)
            {
                <MudChip T="string" Color="Color.Success" Size="Size.Small">Interactive ✓</MudChip>
            }
        </MudStack>
    </MdsMainSection>

    @* ChatBar *@
    <MdsMainSection Title="MdsChatBar">
        <MdsChatBar Placeholder="@("Type a message to test binding…")"
                    @bind-Value="_chatValue" />
        @if (!string.IsNullOrEmpty(_chatValue))
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Bound value: @_chatValue
            </MudText>
        }
    </MdsMainSection>

    @* FilterTabBar *@
    <MdsMainSection Title="MdsFilterTabBar">
        <MdsFilterTabBar T="string" @bind-Value="_tab" Items="@_tabs" />
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            Selected tab: @_tab
        </MudText>
    </MdsMainSection>

    @* DocumentCards *@
    <MdsMainSection Title="MdsDocumentCard">
        <MudGrid Spacing="3">
            @foreach (var card in _cards)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MdsDocumentCard Icon="@card.Icon"
                                     TypeLabel="@card.Type"
                                     Title="@card.Title"
                                     Description="@card.Desc"
                                     OnClick="@(() => _lastCard = card.Title)" />
                </MudItem>
            }
        </MudGrid>
        @if (_lastCard is not null)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Last card clicked: @_lastCard
            </MudText>
        }
    </MdsMainSection>

</MudStack>

@code {
    [Parameter] public string RenderModeName { get; set; } = "Unknown";
    [Parameter] public string BadgeColor     { get; set; } = "default";
    [Parameter] public string BadgeIcon      { get; set; } = Icons.Material.Outlined.Info;
    private Color ModeColor => BadgeColor switch { "server" => Color.Info, "wasm" => Color.Success, "auto" => Color.Warning, _ => Color.Default };

    private int     _count     = 0;
    private string  _chatValue = string.Empty;
    private string  _tab       = "pages";
    private string? _lastCard;

    private readonly MbxTabItem<string>[] _tabs =
    [
        new("images",   "Images"),
        new("pages",    "Pages"),
        new("reports", "Reports"),
    ];

    private readonly (string Icon, string Type, string Title, string Desc)[] _cards =
    [
        (Icons.Material.Outlined.Description, "Page",    "Things to do in Tokyo",
         "Tokyo offers a vibrant mix of traditional culture and modern attractions."),
        (Icons.Material.Outlined.BarChart,    "Report", "Q3 report",
         "Analysis of user engagement metrics for the quarter."),
        (Icons.Material.Outlined.Image,       "Image",   "Project preview",
         "High-fidelity mockup of the application home page."),
    ];
}
