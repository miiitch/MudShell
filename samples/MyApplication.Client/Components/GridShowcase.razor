@namespace MyApplication.Client.Components

<MdsFillLayout>
    <Bands>
        <MudChip T="string" Icon="@BadgeIcon" Color="@ModeColor">@RenderModeName</MudChip>
    </Bands>
    <Body>
        <MdsFillRegion Class="pa-4">
            <MudGrid Spacing="3">
                @foreach (var card in _cards)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MdsMainPart Title="@card.Title" Icon="@card.Icon" Subtitle="@card.Description">
                            <MudStack Row Wrap="Wrap.Wrap">
                                <MudChip T="string" Size="Size.Small" Color="Color.Default">@card.Tag1</MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Default">@card.Tag2</MudChip>
                            </MudStack>
                        </MdsMainPart>
                    </MudItem>
                }
            </MudGrid>
        </MdsFillRegion>
    </Body>
</MdsFillLayout>

@code {
    [Parameter] public string RenderModeName { get; set; } = "Unknown";
    [Parameter] public string BadgeColor     { get; set; } = "default";
    [Parameter] public string BadgeIcon      { get; set; } = Icons.Material.Outlined.Info;
    private Color ModeColor => BadgeColor switch { "server" => Color.Info, "wasm" => Color.Success, "auto" => Color.Warning, _ => Color.Default };

    private record CardInfo(string Icon, string Title, string Description, string Tag1, string Tag2);

    private readonly CardInfo[] _cards =
    [
        new(Icons.Material.Outlined.Analytics, "Dashboard", "Overview of the application's main KPIs and metrics.", "Analytics", "KPI"),
        new(Icons.Material.Outlined.Group, "Users", "Manage user accounts, roles and access permissions.", "IAM", "RBAC"),
        new(Icons.Material.Outlined.Inventory2, "Inventory", "Track stock levels, threshold alerts and replenishment in real time.", "Stock", "Alerts"),
        new(Icons.Material.Outlined.Paid, "Billing", "Billing history, active subscriptions and payment methods.", "Billing", "SaaS"),
        new(Icons.Material.Outlined.Cloud, "Infrastructure", "Monitor cloud services, latency and endpoint availability.", "Cloud", "Monitoring"),
        new(Icons.Material.Outlined.Security, "Security", "Access auditing, anomaly detection and regulatory compliance.", "Audit", "Compliance"),
        new(Icons.Material.Outlined.IntegrationInstructions, "Integrations", "Third-party API connectors, webhooks and automation pipelines.", "API", "Webhooks"),
        new(Icons.Material.Outlined.SupportAgent, "Support", "Open tickets, SLAs and customer satisfaction over the last 30 days.", "Tickets", "SLA"),
    ];
}
