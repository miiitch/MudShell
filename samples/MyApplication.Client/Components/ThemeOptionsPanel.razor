@namespace MyApplication.Client.Components
@using MudShell.Components.AppShell
@using MudShell.Theme
@inject ThemeState ThemeState
@implements IDisposable

<MudStack Spacing="2" Class="pa-3">
    <MudText Typo="Typo.subtitle2">Theme preset</MudText>

    <MudStack Spacing="2">
        <MudSelect T="MbxTheme.MbxThemePreset"
                   Label="Theme"
                   Dense="true"
                   data-testid="theme-preset"
                   Value="@ThemeState.SelectedPreset"
                   ValueChanged="@OnPresetChanged">
            @foreach (var preset in ThemeState.Presets.OrderBy(p => p.Label))
            {
                <MudSelectItem Value="@preset.Preset">@preset.Label</MudSelectItem>
            }
        </MudSelect>

        <MudSwitch T="bool"
                   Color="Color.Primary"
                   Value="@ThemeState.IsDarkMode"
                   ValueChanged="@ThemeState.SetDarkMode"
                   data-testid="theme-dark-mode"
                   Label="Dark mode" />
    </MudStack>

    <MudStack>
        <MudSwitch T="bool"
                   Color="Color.Primary"
                   Value="@IsImageMode"
                   ValueChanged="@OnBackgroundModeChanged"
                   data-testid="theme-background"
                   Label="@(IsImageMode ? "Image background" : "Palette background")" />
    </MudStack>

    <MudStack>
        <MudSwitch T="bool"
                   Color="Color.Primary"
                   Value="@IsCompactDensity"
                   ValueChanged="@OnDensityChanged"
                   data-testid="theme-density"
                   Label="@(IsCompactDensity ? "Compact" : "Comfortable")" />
    </MudStack>

</MudStack>

@code {
    protected override void OnInitialized()
    {
        ThemeState.Changed += OnThemeChanged;
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private void OnPresetChanged(MbxTheme.MbxThemePreset preset)
    {
        ThemeState.ApplyPreset(preset);
    }

    private bool IsImageMode => ThemeState.BackgroundMode == MdsAppShell.MbxBackgroundMode.Image;

    private void OnBackgroundModeChanged(bool useImageBackground)
    {
        var mode = useImageBackground ? MdsAppShell.MbxBackgroundMode.Image : MdsAppShell.MbxBackgroundMode.Palette;
        ThemeState.SetBackgroundMode(mode, "/imgs/bg1.jpg");
    }

    private bool IsCompactDensity => ThemeState.Density == MdsDensity.Compact;

    private void OnDensityChanged(bool compact) =>
        ThemeState.SetDensity(compact ? MdsDensity.Compact : MdsDensity.Comfortable);

    public void Dispose() => ThemeState.Changed -= OnThemeChanged;
}
