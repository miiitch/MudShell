@namespace MudShell.Components.DocumentCard

<button type="button" class="mbx-doc-card" disabled="@Disabled" @onclick="HandleClick" @attributes="AdditionalAttributes">
    <div class="mbx-doc-card-type d-flex align-center">
        <MudIcon Icon="@Icon" Size="Size.Small" />
        <MudText Typo="Typo.caption">@TypeLabel</MudText>
    </div>
    <MudText Typo="Typo.subtitle1" Class="mbx-doc-card-title">@Title</MudText>
    <MudText Typo="Typo.body2"     Class="mbx-doc-card-desc">@Description</MudText>
</button>

@code {
    /// <summary>Undeclared attributes, splatted onto the root element (e.g. <c>data-testid</c>, ARIA attributes).</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    [Parameter] public string  Icon        { get; set; } = Icons.Material.Outlined.Description;
    [Parameter] public string? TypeLabel   { get; set; } = "Document";
    [Parameter] public string? Title       { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private async Task HandleClick() => await OnClick.InvokeAsync();
}
