@page "/library"
@page "/examples/library"
@rendermode InteractiveServer

<div class="showcase-page">
    <MdsPageHeader Title="Bibliothèque" BreadcrumbItems="@_breadcrumbs" />
    <MdsMainToolbar>
        <MudTooltip Text="Ajouter un document fictif">
            <MudIconButton Variant="Variant.Filled" Color="Color.Primary" Icon="@Icons.Material.Outlined.Add"
                           aria-label="Ajouter un document fictif" OnClick="@AddPage" data-testid="library-add" />
        </MudTooltip>
        <MudSpacer />
        <MudText Typo="Typo.caption">@_pages.Count documents fictifs</MudText>
    </MdsMainToolbar>
    <MudTextField T="string" @bind-Value="_query" Immediate Label="Rechercher un document" Class="mb-3" />
    <MdsFilterTabBar T="string" Items="@_tabs" @bind-Value="_selectedTab" />
    <div class="showcase-cards my-4">
        @foreach (var doc in Visible)
        {
            <MdsDocumentCard Icon="@Icons.Material.Outlined.Description" TypeLabel="@doc.Kind"
                             Title="@doc.Title" Description="@doc.Description" />
        }
    </div>
    @if (!Visible.Any())
    {
        <MdsMainEmptyState Title="Aucun document" Description="Modifiez la recherche ou ajoutez un document fictif.">
            <Action><MdsMainButton OnClick="@AddPage">Ajouter un document fictif</MdsMainButton></Action>
        </MdsMainEmptyState>
    }
    <ShowcaseDetails FamilyId="documents" />
</div>

@code {
    private string _selectedTab = "all";
    private string _query = "";
    private readonly List<BreadcrumbItem> _breadcrumbs = [new("Exemples", "/examples")];
    private readonly MbxTabItem<string>[] _tabs = [new("all", "Tous"), new("Page", "Pages"), new("Rapport", "Rapports"), new("Image", "Images")];
    private readonly List<PageItem> _pages =
    [
        new("Présentation du projet", "Objectifs, équipe et prochaines étapes.", "Page"),
        new("Notes de réunion", "Décisions et actions à suivre.", "Page"),
        new("Rapport trimestriel", "Indicateurs et résultats de l’équipe.", "Rapport")
    ];
    private IEnumerable<PageItem> Visible => _pages.Where(p => (_selectedTab == "all" || p.Kind == _selectedTab)
        && p.Title.Contains(_query, StringComparison.OrdinalIgnoreCase));
    private void AddPage()
    {
        _pages.Insert(0, new($"Document {_pages.Count + 1}", "Document fictif ajouté dans cette session.", "Page"));
        _selectedTab = "all";
        _query = "";
    }
    private sealed record PageItem(string Title, string Description, string Kind);
}
